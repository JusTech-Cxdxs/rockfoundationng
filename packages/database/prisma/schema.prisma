// ============================================================================
// EJO: the workshop platform's database schema
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooled connection (used at runtime)
  directUrl = env("DIRECT_URL")   // direct connection (used for migrations / prisma db push)
}

// ----------------------------------------------------------------------------
// MODULE REGISTRY: which modules are live. The portal's sidebar and router
// read this, so activating a module is configuration only.
// ----------------------------------------------------------------------------
enum ModuleStatus {
  LIVE
  COMING_SOON
  DISABLED
}

model PlatformModule {
  id          String       @id @default(cuid())
  key         String       @unique // e.g. "workshop", "hr", "finance"
  name        String
  description String?
  status      ModuleStatus @default(COMING_SOON)
  sortOrder   Int          @default(0)
  icon        String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  organisationModules OrganisationModule[]

  @@map("platform_modules")
}

// Per-organisation override of a module's status (e.g. COMING_SOON platform-wide
// but LIVE for one organisation).
model OrganisationModule {
  id        String       @id @default(cuid())
  organisationId String
  moduleId  String
  status    ModuleStatus
  organisation Organisation        @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  module    PlatformModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([organisationId, moduleId])
  @@map("organisation_modules")
}

// ----------------------------------------------------------------------------
// BRANDING: one row per organisation; the portal, PDFs and emails read their
// colours from here.
// ----------------------------------------------------------------------------
model Branding {
  id              String   @id @default(cuid())
  organisationId       String   @unique
  organisation Organisation  @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  logoUrl         String?
  logoDarkUrl     String?
  faviconUrl      String?

  primaryColor    String   @default("#16A34A") // brand green
  secondaryColor  String   @default("#0F172A")
  accentColor     String   @default("#22C55E")
  successColor    String   @default("#16A34A")
  warningColor    String   @default("#F59E0B")
  errorColor      String   @default("#DC2626")
  infoColor       String   @default("#2563EB")

  fontFamily      String   @default("Inter")

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("branding")
}

// ----------------------------------------------------------------------------
// ORGANISATION HIERARCHY
// Platform -> Organisation -> Business Unit -> Country -> State -> City -> Branch
//   -> Department -> Team -> User
// Every level is ordinary data; nothing is specific to one organisation.
// ----------------------------------------------------------------------------

model Organisation {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  legalName   String?
  website     String?
  // Contact and registration details printed on letterheads and receipts.
  // All optional. Hotlines are a string array, printed in order.
  hotlines    String[] @default([])
  hqAddress   String?
  poBox       String?
  rcNumber    String?
  email       String?
  // Primary Service interval ("whichever comes first"), the basis for
  // next-service predictions. Null until the organisation sets it; no
  // prediction is made without it.
  primaryServiceIntervalKm   Int?
  primaryServiceIntervalDays Int?
  // Data Exchange: days after an import is finished (and its totals signed
  // off) before the staged copy of its file is released. Null = 30; 0 = never.
  importStagingDays Int?
  // Billing & tax (Organisation → Billing & tax). VAT is charged on the
  // discounted customer total only when switched on; the TIN prints on
  // invoices. A whole-estimate discount above discountApprovalPercent of the
  // customer subtotal needs the Manager; null = every discount does.
  vatEnabled  Boolean  @default(false)
  vatRate     Decimal  @default(7.5) @db.Decimal(5, 2)
  vatNumber   String?
  discountApprovalPercent Int?
  // A deposit before work starts (Organisation → Billing & tax): off unless
  // switched on, and then only for individual customers — never for an
  // organisation (company or fleet) customer. depositPercent (1–100) is used
  // only while depositRequired is on.
  // The optional roles switched on in Settings → Roles (workshop-supervisor,
  // technician, store-keeper, accounts, security). Owner and Front Desk are
  // always on; while a role is off, Front Desk covers its steps.
  optionalRoles String[] @default([])
  depositRequired Boolean @default(false)
  depositPercent  Int     @default(70)
  // A demonstration organisation: the only kind that gets demo people with
  // sign-ins and demo records (apps/portal/lib/demo). Set by the platform
  // team or `npm run demo:reset`; a real organisation never has it.
  isDemo      Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  branding      Branding?
  businessUnits BusinessUnit[]
  organisationModules OrganisationModule[]
  users         User[]
  roles         Role[]
  customers     Customer[]
  announcements Announcement[]

  @@map("organisations")
  broadcasts Broadcast[]
  importJobs ImportJob[]
  importMappingProfiles ImportMappingProfile[]
  suppliers  Supplier[]
  historicalInvoices    HistoricalInvoice[]
  historicalJobs     HistoricalJob[]
  exportJobs ExportJob[]
  invoices      Invoice[]
  documentLinks DocumentLink[]
}

model BusinessUnit {
  id        String   @id @default(cuid())
  organisationId String
  name      String   // e.g. "Autocare", "Fleet Services"
  slug      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organisation Organisation    @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  countries CountryLink[]
  branches  Branch[]

  @@unique([organisationId, slug])
  @@map("business_units")
}

model Country {
  id       String @id @default(cuid())
  name     String @unique // e.g. "Nigeria"
  isoCode  String @unique // e.g. "NG"

  states       State[]
  businessUnits CountryLink[]

  @@map("countries")
}

// Join table: which business units operate in which countries.
model CountryLink {
  id             String       @id @default(cuid())
  businessUnitId String
  countryId      String
  businessUnit   BusinessUnit @relation(fields: [businessUnitId], references: [id], onDelete: Cascade)
  country        Country      @relation(fields: [countryId], references: [id], onDelete: Cascade)

  @@unique([businessUnitId, countryId])
  @@map("business_unit_countries")
}

model State {
  id        String   @id @default(cuid())
  countryId String
  name      String   // e.g. "Lagos State"

  country   Country   @relation(fields: [countryId], references: [id], onDelete: Cascade)
  cities    City[]

  @@unique([countryId, name])
  @@map("states")
}

model City {
  id      String @id @default(cuid())
  stateId String
  name    String // e.g. "Ota"

  state    State    @relation(fields: [stateId], references: [id], onDelete: Cascade)
  branches Branch[]

  @@unique([stateId, name])
  @@map("cities")
}

/// What kind of place a branch is (apps/portal/lib/branch-types.ts): job
/// cards live only on a WORKSHOP branch; a WAREHOUSE keeps stock only.
enum BranchType {
  WORKSHOP
  HEAD_OFFICE
  WAREHOUSE
}

model Branch {
  id             String   @id @default(cuid())
  businessUnitId String
  cityId         String
  name           String   // e.g. "Ota Workshop"
  code           String?  // short code used in document numbering, e.g. "OTA"
  type           BranchType @default(WORKSHOP)
  address        String?
  // The branch's own hotlines, printed separately from the organisation's
  // (e.g. head office and a workshop branch on the same Job Card).
  hotlines       String[] @default([])
  email          String?
  // The branch's own bank account for customer deposits and payments —
  // printed on every estimate email, PDF and print-out for this branch.
  bankName          String?
  bankAccountName   String?
  bankAccountNumber String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  businessUnit BusinessUnit @relation(fields: [businessUnitId], references: [id], onDelete: Cascade)
  city         City         @relation(fields: [cityId], references: [id], onDelete: Cascade)
  departments  Department[]
  users        User[]
  jobCards     JobCard[]
  parts          Part[]
  goodsReceipts  GoodsReceipt[]
  partRequestSlips PartRequestSlip[]
  partCategories PartCategory[]
  partTypes      PartType[]

  invoices     Invoice[]
  @@map("branches")
  vehicleGateExits VehicleGateExit[]
}

model Department {
  id        String   @id @default(cuid())
  branchId  String
  name      String   // e.g. "Workshop", "HR", "Finance", "Store"
  slug      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  teams  Team[]
  users  User[]
  jobCards JobCard[]

  @@unique([branchId, slug])
  @@map("departments")
}

model Team {
  id           String   @id @default(cuid())
  departmentId String
  name         String   // e.g. "Technicians", "Store Officers"
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  users      User[]

  @@map("teams")
}

// ----------------------------------------------------------------------------
// IDENTITY & ACCESS
// User = employees and platform administrators only. Customers are a separate
// model (CUSTOMER section below), so a staff account can never satisfy a
// customer query, or the reverse.
//
// Session / Account / Verification follow Better Auth's adapter schema
// (https://www.better-auth.com); field names are set by that library.
// Customers have their own tables (CustomerSession, CustomerAccount,
// CustomerVerification) used by the website's separate auth instance.
// ----------------------------------------------------------------------------

enum AccountType {
  EMPLOYEE
  ADMIN
}

model User {
  id            String      @id @default(cuid())
  // Nullable: an account may exist before an administrator places it in an
  // organisation. Such a user sees nothing beyond their own account settings.
  organisationId     String?
  branchId      String?
  departmentId  String?
  teamId        String?

  accountType   AccountType @default(EMPLOYEE)

  employeeId    String?     @unique // human-facing staff number
  fullName      String
  email         String      @unique
  emailVerified Boolean     @default(false) // required by Better Auth
  image         String?                     // required by Better Auth (avatar URL)
  phone         String?
  photoUrl      String?

  isActive      Boolean     @default(true)
  lastLoginAt   DateTime?
  // Brought in from another system: where from (LEGACY), the
  // personnel number there (kept and searchable), the import, and when the
  // set-password invitation was sent (an imported account stays switched off
  // until an administrator sends it).
  externalSource String?
  externalId     String?
  importJobId    String?
  invitedAt      DateTime?

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  organisation Organisation?    @relation(fields: [organisationId], references: [id])
  branch     Branch?     @relation(fields: [branchId], references: [id])
  department Department? @relation(fields: [departmentId], references: [id])
  team       Team?       @relation(fields: [teamId], references: [id])

  roles           UserRole[]
  sessions        Session[]
  accounts        Account[]
  employeeProfile EmployeeProfile?
  jobCardsAssigned JobCard[] @relation("JobCardTechnician")
  jobCardsSupervised JobCard[] @relation("JobCardSupervisor")
  jobCardsApproved JobCard[] @relation("JobCardApprovedBy")
  estimateLineItemsEntered EstimateLineItem[]
  estimatesCreated Estimate[] @relation("EstimateCreatedBy")
  estimatesApproved Estimate[] @relation("EstimateApprovedBy")
  estimatesManagerApproved Estimate[] @relation("EstimateManagerApprovedBy")
  estimatesCustomerNotified Estimate[] @relation("EstimateCustomerNotifiedBy")
  estimatesMatchingRequested Estimate[] @relation("EstimateMatchingRequestedBy")
  paymentsRecorded Payment[]
  cancellationRequestsMade CancellationRequest[] @relation("CancellationRequestedBy")
  cancellationRequestsDecided CancellationRequest[] @relation("CancellationDecidedBy")
  closeRequestsMade CloseRequest[] @relation("CloseRequestedBy")
  closeRequestsDecided CloseRequest[] @relation("CloseDecidedBy")
  pricingAlertsResolved PricingAlert[] @relation("PricingAlertResolvedBy")
  announcementsCreated Announcement[] @relation("AnnouncementCreatedBy")
  vehicleInspections VehicleInspection[] @relation("VehicleInspectionInspector")
  refundsRecorded Refund[] @relation("RefundRecordedBy")
  invoicesIssued  Invoice[] @relation("InvoiceIssuedBy")
  estimateDiscountsApproved Estimate[] @relation("EstimateDiscountApprovedBy")
  estimateCustomerApprovalsTaken Estimate[] @relation("EstimateCustomerApprovedByStaff")
  estimateApprovalLinksCreated EstimateApprovalLink[] @relation("EstimateApprovalLinkCreatedBy")
  documentLinksCreated DocumentLink[] @relation("DocumentLinkCreatedBy")
  customerCreditApproved CustomerCompany[] @relation("CustomerCreditApprovedBy")
  jobCardsCreated  JobCard[] @relation("JobCardCreatedBy")
  customersCreated Customer[] @relation("CustomerCreatedBy")
  vehiclesCreated  CustomerVehicle[] @relation("VehicleCreatedBy")
  partsCreated       Part[] @relation("PartCreatedBy")
  partCategoriesCreated PartCategory[] @relation("PartCategoryCreatedBy")
  partTypesCreated      PartType[] @relation("PartTypeCreatedBy")
  goodsReceiptsTaken GoodsReceipt[] @relation("GoodsReceiptReceivedBy")
  partRequestSlipsRequested    PartRequestSlip[] @relation("PartRequestSlipRequestedBy")
  partRequestSlipsHodApproved  PartRequestSlip[] @relation("PartRequestSlipHodApprovedBy")
  partRequestSlipsStoreApproved PartRequestSlip[] @relation("PartRequestSlipStoreApprovedBy")
  partRequestSlipsReleased     PartRequestSlip[] @relation("PartRequestSlipReleasedBy")
  partRequestSlipsRejected     PartRequestSlip[] @relation("PartRequestSlipRejectedBy")
  partRequestSlipsReceived     PartRequestSlip[] @relation("PartRequestSlipReceivedBy")

  @@index([organisationId])
  @@index([branchId])
  @@index([importJobId])
  @@index([organisationId, externalSource, externalId])
  @@map("users")
  vehicleGateExits VehicleGateExit[] @relation("VehicleGateExitBy")
  broadcastsCreated Broadcast[] @relation("BroadcastCreatedBy")
  broadcastsStopped Broadcast[] @relation("BroadcastStoppedBy")
  notificationReads NotificationRead[] @relation("NotificationReads")
  customerNotes     CustomerNote[]     @relation("CustomerNoteAuthor")
  notificationPreference NotificationPreference? @relation("NotificationPreference")
  importJobsCreated  ImportJob[] @relation("ImportJobCreatedBy")
  importJobsApproved ImportJob[] @relation("ImportJobApprovedBy")
  importMappingProfilesCreated ImportMappingProfile[] @relation("ImportMappingProfileCreatedBy")
  suppliersCreated  Supplier[] @relation("SupplierCreatedBy")
  followUpsAssigned FollowUp[] @relation("FollowUpAssignee")
}

// One-to-one HR extension of User, keeping the identity table small.
model EmployeeProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Employment
  jobTitle         String?
  employmentType   String?   // Full-time, Part-time, Contract, Intern, NYSC, Consultant...
  employmentStatus String?   // Active, Suspended, On Leave, Resigned, Retired, Terminated
  dateEmployed     DateTime?
  reportingManagerId String?

  // Emergency contact (one per employee).
  emergencyContactName         String?
  emergencyContactRelationship String?
  emergencyContactPhone        String?

  // Signature / notification preferences
  signatureUrl               String?
  notifyByEmail               Boolean @default(true)
  notifyByInApp                Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documents EmployeeDocument[]

  @@map("employee_profiles")
}

model EmployeeDocument {
  id                String          @id @default(cuid())
  employeeProfileId String
  employeeProfile   EmployeeProfile @relation(fields: [employeeProfileId], references: [id], onDelete: Cascade)

  type    String // CV, Employment Letter, Contract, Certificate, Medical Fitness...
  fileUrl String
  uploadedAt DateTime @default(now())

  @@map("employee_documents")
}

model Role {
  id          String   @id @default(cuid())
  organisationId   String
  name        String   // e.g. "Technician", "Workshop Supervisor", "Administrator"
  slug        String
  description String?
  isSystem    Boolean  @default(false) // true for built-in roles that can't be deleted
  // Bypasses permission checks entirely: every current and future permission
  // without RolePermission rows. Only for the platform's Master Administrator
  // role; never grant it to organisation roles.
  isSuperAdmin Boolean @default(false)

  organisation Organisation          @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  users       UserRole[]
  permissions RolePermission[]

  @@unique([organisationId, slug])
  @@map("roles")
}

model Permission {
  id          String @id @default(cuid())
  key         String @unique // e.g. "workshop.job_card.approve"
  description String?

  roles RolePermission[]

  @@map("permissions")
}

model UserRole {
  id     String @id @default(cuid())
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

// ----------------------------------------------------------------------------
// CUSTOMER IDENTITY: separate from User (employees). A customer session can
// never resolve to a User row, so a customer account cannot reach a staff
// route.
// ----------------------------------------------------------------------------

// Individual or organisation (e.g. a trading company). `fullName` on
// Customer holds either a person's or an organisation's name, as on the
// paper estimate form.
enum CustomerType {
  INDIVIDUAL
  ORGANIZATION
}

model Customer {
  id            String       @id @default(cuid())
  organisationId     String       // which organisation this customer belongs to

  customerType  CustomerType @default(INDIVIDUAL)
  fullName      String
  // Primary address: one short line printed on the Job Card (max 80 characters,
  // enforced in the app). Extra addresses go in CustomerAddress.
  address       String?
  // Optional: customers brought in from QuickBooks or old spreadsheets often
  // have no email, or share a fleet address. Unique when present (Postgres
  // allows many NULLs under a unique index). Only a customer with a real,
  // verified email can use the customer portal; the others are full CRM
  // records reached by phone. Never filled with a made-up address.
  email         String?      @unique
  emailVerified Boolean      @default(false)
  image         String?
  phone         String?
  // An optional second number. Primary address and phone are required for
  // customers registered in EJO (enforced in the app; imported records may
  // lack them and are flagged in the CRM).
  altPhone      String?
  // Free labels the organisation uses to group customers ("Fleet", "VIP").
  tags          String[] @default([])
  // The customer's own choice: also receive updates by email.
  notifyByEmail Boolean  @default(true)
  // How the customer prefers to be reached; WhatsApp first.
  preferredContact ContactChannel @default(WHATSAPP)
  // A WhatsApp number when it differs from the main phone.
  whatsappPhone String?
  // Birthday (day and month only, never the year) for a birthday call.
  birthDay      Int?
  birthMonth    Int?

  isActive      Boolean  @default(true)
  lastLoginAt   DateTime?

  // The number this customer has in another system: externalSource is where
  // it came from (QUICKBOOKS, LEGACY_EXCEL), externalId the number there.
  // Unique per organisation and source, so an
  // import matched on it never creates the same customer twice.
  externalSource String?
  externalId     String?
  // The import that created this customer (Data Exchange): "Undo this import" removes exactly these.
  importJobId    String?
  // When this imported customer was invited to the customer portal from their import (once; a new link
  // after that is sent from their own page). Null: never invited that way.
  portalInvitedAt DateTime?
  // When they became a customer of the business (from QuickBooks or the old
  // system), which can be years
  // before this record was made (createdAt). Analytics read customerSince when
  // present, otherwise createdAt.
  customerSince  DateTime? @db.Date

  // Nullable: customers who sign themselves up have no staff creator.
  createdById   String?
  createdBy     User?    @relation("CustomerCreatedBy", fields: [createdById], references: [id])

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  organisation Organisation            @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  sessions   CustomerSession[]
  accounts   CustomerAccount[]

  customerCompany CustomerCompany?
  vehicles        CustomerVehicle[]
  addresses       CustomerAddress[]
  contacts        CustomerContact[]
  jobCards        JobCard[]

  @@index([organisationId])
  @@unique([organisationId, externalSource, externalId])
  @@index([importJobId])
  // Search by the old-system number alone.
  @@index([organisationId, externalId])
  invoices        Invoice[]
  @@map("customers")
  notes           CustomerNote[]
  notificationReads CustomerNotificationRead[]
  followUps       FollowUp[]
  jobRatings      JobRating[]
}

// Optional company details when the customer is a business (fleet account).
model CustomerCompany {
  id         String   @id @default(cuid())
  customerId String   @unique
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  companyName String
  taxId       String?
  // Credit terms (Customers → the organisation's page), set by Finance or the
  // Manager: on credit = paymentTermsDays > 0 and approved. Its Job Cards
  // need no deposit and can leave with a balance once invoiced, while its
  // unpaid invoices stay within creditLimit (no limit when blank).
  creditLimit        Decimal?  @db.Decimal(14, 2)
  paymentTermsDays   Int?
  creditApprovedById String?
  creditApprovedAt   DateTime?
  creditApprovedBy   User?     @relation("CustomerCreditApprovedBy", fields: [creditApprovedById], references: [id])

  @@map("customer_companies")
}

model CustomerVehicle {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  make         String?
  model        String?
  vehicleType  VehicleCategory? // Passenger vs Commercial — the Workshop's two operational sections
  year         Int?
  plateNumber  String?  @unique // no two vehicles may share a plate
  chassisNumber String? @unique // VIN — globally unique per vehicle by definition
  engineNumber String?
  // Engine type (e.g. "ISF2.8", "4HK1"), the key for parts fitment. Not the
  // engine serial number (engineNumber). One model name can have different
  // engines, and different models can share one.
  engineType   String?
  mileage       Int?     // last known odometer reading, updated at each Job Card check-in
  // The vehicle's own service interval, overriding the organisation's
  // default (Organisation.primaryServiceIntervalKm/Days) when set.
  serviceIntervalKm   Int?
  serviceIntervalDays Int?

  // The vehicle's number in another system (an old spreadsheet's fleet number).
  // Vehicles have no organisation column of their own (they belong through the
  // customer), so this is indexed, and the importer checks it within the
  // customer's organisation. The VIN and plate stay the real unique keys.
  externalSource String?
  externalId     String?
  // The import that created this vehicle (Data Exchange).
  importJobId    String?

  createdById String? // staff member who registered this vehicle
  createdBy   User?   @relation("VehicleCreatedBy", fields: [createdById], references: [id])
  createdAt    DateTime @default(now())

  jobCards JobCard[]
  reminderLogs ServiceReminderLog[]

  @@index([customerId])
  @@index([externalSource, externalId])
  @@index([externalId])
  @@index([importJobId])
  @@map("customer_vehicles")
  gateExits VehicleGateExit[]
}

enum VehicleCategory {
  PASSENGER
  COMMERCIAL
}

enum VehicleInspectionStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  SKIPPED
}

// Four levels, the same vocabulary as Service Health.
enum InspectionSeverity {
  GOOD
  ATTENTION
  SERVICE_REQUIRED
  CRITICAL
}

// ----------------------------------------------------------------------------
// WORKSHOP
// ----------------------------------------------------------------------------

enum JobType {
  SERVICE
  REPAIR
  SERVICE_AND_REPAIR
  DIAGNOSTICS
  SPRAYING
  CAR_WASH
}

enum JobCardStatus {
  CHECKED_IN
  IN_PROGRESS
  AWAITING_PARTS
  QUALITY_CHECK
  // The approved estimate has been sent to the customer (set by
  // notifyCustomerOfApprovedEstimate). Work waits for the deposit.
  AWAITING_CUSTOMER_APPROVAL
  COMPLETED
  READY_FOR_COLLECTION
  CLOSED
  // The vehicle has left the workshop. Distinct from CLOSED, which is an
  // administrative sign-off while the vehicle may still be in the yard.
  // Reached from CLOSED, or from CANCELLED when the vehicle is handed back
  // (the only move out of CANCELLED).
  CHECKED_OUT
  CANCELLED
}

// Separate from JobCardStatus; see JobCard.approvalStatus.
enum JobCardApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

// Whether the assigned technician has accepted the work. Same shape as
// JobCardApprovalStatus.
enum TechnicianAcceptanceStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model JobCard {
  id          String        @id @default(cuid())
  jobNumber   String        @unique // human-facing, e.g. "JC-2026-000123" — generated server-side, never user-entered
  branchId    String
  customerId  String
  vehicleId   String
  // Passenger or Commercial Workshop department, derived from
  // vehicle.vehicleType at creation. Nullable for Job Cards created before
  // the field existed.
  departmentId String?

  complaint   String?       // legacy single-field complaint, kept for Job Cards created before per-item complaints existed — new Job Cards use `complaints` below instead
  diagnosis   String?       // technician/service-advisor findings, filled in after inspection
  mileageAtCheckIn Int?
  // What kind of visit (one Job Card for every kind). SERVICE and
  // SERVICE_AND_REPAIR start the vehicle's next-service count (isService).
  jobType     JobType       @default(REPAIR)
  // Check-in: fuel in eighths of a tank (0 empty … 8 full) and what was left
  // in the vehicle, so both are agreed with the customer at the desk.
  fuelLevel   Int?
  itemsInVehicle String?
  // Spraying: the colour (name and paint code) and the panels to be sprayed.
  sprayColour     String?
  sprayColourCode String?
  sprayPanels     String[]  @default([])
  // Car wash: the package chosen at the quick check-in.
  washPackage     String?

  assignedTechnicianId String? // User.id — nullable until a technician is assigned
  // Separate from status/approvalStatus: being assigned is not the same as
  // accepting. Null when no technician is assigned; PENDING when assigned;
  // cleared on reassignment.
  technicianAcceptanceStatus   TechnicianAcceptanceStatus?
  technicianRespondedAt       DateTime?
  technicianRejectionReason   String? // required when the technician rejects, mirrors JobCard.rejectionReason's role for approval
  // The Workshop Supervisor of the resolved department. createJobCard checks
  // the chosen supervisor belongs to that department.
  supervisorId String?
  createdById String        // User.id — staff member who opened this Job Card

  status      JobCardStatus @default(CHECKED_IN)
  notes       String?

  // Separate from status: a Job Card can be CHECKED_IN and PENDING approval at
  // once. Status is where the vehicle is in the workflow; approval is whether
  // the supervisor has signed off.
  approvalStatus   JobCardApprovalStatus @default(PENDING)
  approvedById     String?   // User.id — who approved or rejected it
  approvedAt       DateTime? // when the current approvalStatus was set
  rejectionReason  String?   // short, required when rejecting — e.g. "Incomplete vehicle information"
  approvalNotes    String?   // optional longer commentary, on either an approval or a rejection

  closedAt    DateTime?
  // Set on entering READY_FOR_COLLECTION; anchors the collection grace period
  // (READY_FOR_COLLECTION_GRACE_WORKING_DAYS).
  readyForCollectionAt DateTime?
  // First time the Job Card reaches IN_PROGRESS (start of work). Not
  // overwritten when work resumes after AWAITING_PARTS.
  workStartedAt DateTime?
  // First time the Job Card reaches COMPLETED. With workStartedAt, measures
  // repair time, excluding the wait for collection.
  completedAt DateTime?
  // First time the Job Card reaches CHECKED_OUT: the vehicle left. This, not
  // closedAt, ends time in custody.
  checkedOutAt DateTime?
  // Name of whoever collected the vehicle (the customer or someone they
  // sent). Free text: collectors usually have no account.
  collectedByName String?
  // Opened as a routine service, not only a repair (one Job Card for both).
  // Once checked out (not cancelled), it starts the vehicle's next-service
  // count: anchored on mileageAtCheckIn and checkedOutAt, with the vehicle's
  // or organisation's interval.
  isService Boolean @default(false)
  // Staff marked this Job Card's next-service prediction handled (Attend To
  // on the Service Tracker).
  serviceAttendedAt DateTime?
  // Brought in open from another system at the cut-over: where from
  // (LEGACY), its number there (kept and searchable) and the import.
  externalSource String?
  externalId     String?
  importJobId    String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  branch             Branch              @relation(fields: [branchId], references: [id], onDelete: Cascade)
  department         Department?         @relation(fields: [departmentId], references: [id])
  customer           Customer            @relation(fields: [customerId], references: [id], onDelete: Cascade)
  vehicle            CustomerVehicle     @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  assignedTechnician User?               @relation("JobCardTechnician", fields: [assignedTechnicianId], references: [id])
  supervisor         User?               @relation("JobCardSupervisor", fields: [supervisorId], references: [id])
  approvedBy         User?               @relation("JobCardApprovedBy", fields: [approvedById], references: [id])
  createdBy          User                @relation("JobCardCreatedBy", fields: [createdById], references: [id])
  photos             JobCardPhoto[]
  rating             JobRating?
  followUps          FollowUp[]
  inspection         VehicleInspection?
  complaints         JobCardComplaint[]
  estimate           Estimate?
  payments           Payment[]
  refunds Refund[]
  invoice Invoice?
  cancellationRequests CancellationRequest[]
  closeRequests        CloseRequest[]
  partRequestSlips     PartRequestSlip[]
  // Reverse side of VehicleService.escalatedToJobCard.

  @@index([branchId, status])
  @@index([branchId, createdAt])
  @@index([customerId])
  @@index([vehicleId])
  @@index([assignedTechnicianId])
  @@index([supervisorId])
  @@index([importJobId])
  @@index([branchId, externalSource, externalId])
  @@map("job_cards")
  gateExit VehicleGateExit?
}

// One row per reported issue on a Job Card (e.g. "Fan not working",
// "AC not working"). `sequenceNumber` keeps the order they were listed in.
model JobCardComplaint {
  id             String   @id @default(cuid())
  jobCardId      String
  jobCard        JobCard  @relation(fields: [jobCardId], references: [id], onDelete: Cascade)
  sequenceNumber Int
  description    String
  createdAt      DateTime @default(now())

  @@map("job_card_complaints")
}

// One estimate per Job Card. `version` is reserved for estimate revisions
// and is not incremented yet.
// DRAFT: technician and supervisor build it; prices may be blank.
// SUBMITTED: sent to the supervisor; every line must be priced.
// APPROVED: supervisor sign-off; goes to the Workshop Manager.
// MANAGER_APPROVED: final; the customer can then be notified.
enum EstimateStatus {
  DRAFT
  SUBMITTED
  APPROVED
  MANAGER_APPROVED
}

model Estimate {
  id          String         @id @default(cuid())
  jobCardId   String         @unique
  status      EstimateStatus @default(DRAFT)
  version     Int            @default(1)
  submittedAt DateTime?
  approvedAt  DateTime?
  approvedById String?
  // Workshop Manager's sign-off. Managers cover a whole branch, so
  // eligibility is by branch (listEligibleManagersForBranch).
  managerApprovedAt   DateTime?
  managerApprovedById String?
  // Set when the customer is notified. Separate from MANAGER_APPROVED: the
  // Job Card's creator decides when to tell the customer
  // (notifyCustomerOfApprovedEstimate).
  customerNotifiedAt   DateTime?
  customerNotifiedById String?
  // When the approval reminder was last sent; prevents duplicate sends.
  reminderSentAt       DateTime?
  // When Store matching was requested. Store's queue shows only estimates with
  // this set, not every draft. Not cleared: Store Part lines added later
  // appear in the queue straight away.
  matchingRequestedAt   DateTime?
  matchingRequestedById String?
  // A discount on the whole estimate (customer lines only), with the reason.
  // Above the organisation's threshold the Manager approves it; the Manager's
  // final approval of the estimate records that approval here.
  discountAmount       Decimal?  @db.Decimal(12, 2)
  discountReason       String?
  discountApprovedById String?
  discountApprovedAt   DateTime?
  // The VAT rate fixed when the Manager gave final approval (0 = no VAT), so
  // the price the customer approves never changes if VAT is switched on or
  // off or its rate changes. Null while the estimate is being written: the
  // organisation's current setting applies.
  vatRate              Decimal?  @db.Decimal(5, 2)
  // The customer's own answer to the estimate once they have been told:
  // approved by the secure link (LINK), in the customer portal (PORTAL), by
  // phone (PHONE, taken down by customerApprovedByStaffId) or by paying the
  // deposit at the counter (DEPOSIT); IMPORT for records brought in. Or
  // declined, with their note. Sending the estimate back clears both.
  customerApprovedAt        DateTime?
  customerApprovedVia       String?
  customerApprovedByStaffId String?
  customerApprovalNote      String?
  customerDeclinedAt        DateTime?
  customerDeclineNote       String?
  createdById String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  jobCard     JobCard            @relation(fields: [jobCardId], references: [id], onDelete: Cascade)
  createdBy   User               @relation("EstimateCreatedBy", fields: [createdById], references: [id])
  approvedBy  User?              @relation("EstimateApprovedBy", fields: [approvedById], references: [id])
  managerApprovedBy User?        @relation("EstimateManagerApprovedBy", fields: [managerApprovedById], references: [id])
  customerNotifiedBy User?       @relation("EstimateCustomerNotifiedBy", fields: [customerNotifiedById], references: [id])
  matchingRequestedBy User?      @relation("EstimateMatchingRequestedBy", fields: [matchingRequestedById], references: [id])
  discountApprovedBy User?       @relation("EstimateDiscountApprovedBy", fields: [discountApprovedById], references: [id])
  customerApprovedByStaff User?  @relation("EstimateCustomerApprovedByStaff", fields: [customerApprovedByStaffId], references: [id])
  lineItems   EstimateLineItem[]
  approvalLinks EstimateApprovalLink[]

  @@map("estimates")
}

// A secure link that lets the customer approve or decline their estimate
// without signing in (sent in the estimate email, or shared by a colleague
// on WhatsApp). Only the SHA-256 of the token is stored; the token itself is
// shown once, in the message, and never kept or logged. Valid for 7 days and
// for one answer; a new link revokes the older unused ones.
model EstimateApprovalLink {
  id          String    @id @default(cuid())
  estimateId  String
  tokenHash   String    @unique
  expiresAt   DateTime
  usedAt      DateTime?
  revokedAt   DateTime?
  createdById String
  createdAt   DateTime  @default(now())

  estimate    Estimate  @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  createdBy   User      @relation("EstimateApprovalLinkCreatedBy", fields: [createdById], references: [id])

  @@index([estimateId])
  @@map("estimate_approval_links")
}

// Estimate line types, with who may price each (requirePricingAuthority):
//   STORE_PART    — a catalogue part; priced by Store matching.
//   EXTERNAL_PART — a part the technician bought outside; priced by the
//                   technician.
//   EXTERNAL_JOB  — work done outside (e.g. cylinder resurfacing, lathe
//                   work); priced by the technician.
//   INTERNAL_JOB  — named work done in the workshop (alignment, balancing,
//                   body work, AC gas, overhaul…); several allowed; priced
//                   by the supervisor.
//   LABOUR        — a labour charge for a piece of work ("Labour for
//                   Service", "Labour for Brake"); several allowed; priced
//                   by the supervisor.
//   SUNDRY        — small miscellaneous charges; one line per estimate
//                   (enforced in code); priced by the supervisor.
// `enteredById` records who entered each line.
enum EstimateLineItemType {
  STORE_PART
  EXTERNAL_PART
  EXTERNAL_JOB
  INTERNAL_JOB
  LABOUR
  SUNDRY
}

model EstimateLineItem {
  id          String               @id @default(cuid())
  estimateId  String
  type        EstimateLineItemType
  description String
  quantity    Int                  @default(1)
  // Nullable while DRAFT. `amount` is computed server-side once quantity and
  // unitPrice are both known.
  unitPrice   Decimal?             @db.Decimal(12, 2)
  amount      Decimal?             @db.Decimal(12, 2)
  // Taken off this line's amount (customer lines only; never more than the
  // amount). Null = no discount.
  discountAmount Decimal?          @db.Decimal(12, 2)
  enteredById String
  createdAt   DateTime             @default(now())
  // @default(now()) gives existing rows a value when the column is added;
  // @updatedAt alone has no database default.
  updatedAt   DateTime             @default(now()) @updatedAt
  // STORE_PART only: the part type the technician asked for, then the
  // catalogue part Store matched. Null until each step happens.
  partTypeId    String?
  matchedPartId String?
  // For STORE_PART, copied from the matched part's baseUnitOfMeasure; for
  // other lines, entered with the line.
  unitOfMeasure String?

  estimate    Estimate @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  enteredBy   User     @relation(fields: [enteredById], references: [id])
  requestSlipLines PartRequestSlipLine[]
  // Per-line link used by multi-line requests; separate from the legacy
  // request-level relation above.
  partType    PartType? @relation(fields: [partTypeId], references: [id])
  matchedPart Part?     @relation("EstimateLineItemMatchedPart", fields: [matchedPartId], references: [id])

  @@index([estimateId])
  @@map("estimate_line_items")
  // Who pays for this line. CUSTOMER (default) counts towards what the
  // customer owes; WARRANTY lines are covered by the workshop's own warranty
  // (a comeback on earlier work or a part still under warranty); GOODWILL /
  // INTERNAL are absorbed by the business. Only the Owner sets it; audited.
  billTo             EstimateBillTo @default(CUSTOMER)
  billToNote         String?
}

// Payments toward a Job Card's estimate (usually a deposit, then the
// balance), recorded by Finance from proof of a bank transfer or cash at
// the cashier: who recorded what, how much and how.
enum PaymentMethod {
  BANK_TRANSFER
  CASH
}

model Payment {
  id            String        @id @default(cuid())
  // Exactly one of jobCardId / vehicleServiceId is set (enforced in the app).
  jobCardId     String?
  amount        Decimal       @db.Decimal(12, 2)
  method        PaymentMethod
  notes         String?       // e.g. a transfer reference or receipt number
  recordedById  String
  recordedAt    DateTime      @default(now())
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @default(now()) @updatedAt
  /// Operation id from the form — UNIQUE, so the same submission is never recorded twice.
  idempotencyKey String? @unique
  // The customer's receipt number, RCT-2026-000001, given when a Job Card
  // payment is recorded. Payments recorded before receipts existed have none.
  receiptNumber  String? @unique

  jobCard        JobCard?        @relation(fields: [jobCardId], references: [id], onDelete: Cascade)
  recordedBy    User    @relation(fields: [recordedById], references: [id])

  @@index([jobCardId])
  @@index([recordedAt])
  @@map("payments")
}

// Money returned to a customer, e.g. after a cancellation following a
// deposit. Recorded by Finance once a Manager has approved the
// cancellation. Never a negative Payment, so payments stay money in and
// each refund has its own receipt number. Exactly one of jobCardId /
// vehicleServiceId is set.
model Refund {
  id               String        @id @default(cuid())
  referenceNumber  String        @unique // RF-2026-000001
  jobCardId        String?
  amount           Decimal       @db.Decimal(12, 2)
  method           PaymentMethod
  // Whoever physically received the money (cash) or the account holder (transfer).
  paidToName       String
  reason           String
  // Transfer reference, receipt number, or any other note.
  notes            String?
  recordedById     String
  recordedAt       DateTime      @default(now())
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @default(now()) @updatedAt
  /// Operation id from the form — UNIQUE, so the same submission is never recorded twice.
  idempotencyKey String? @unique

  jobCard        JobCard?        @relation(fields: [jobCardId], references: [id], onDelete: Cascade)
  recordedBy     User            @relation("RefundRecordedBy", fields: [recordedById], references: [id])

  @@index([jobCardId])
  @@map("refunds")
}

// The customer's invoice for a Job Card (one per Job Card for now), issued
// when the work is completed. Every figure and line is frozen at issue, so a
// reprint is always the document the customer was given, whatever changes
// later. INV-2026-000001.
model Invoice {
  id                String   @id @default(cuid())
  invoiceNumber     String   @unique
  organisationId    String
  branchId          String
  jobCardId         String   @unique
  customerId        String
  // Customer lines after their own discounts; the line discounts; the
  // whole-estimate discount; VAT (rate 0 when VAT was off); what was due.
  subtotal          Decimal  @db.Decimal(12, 2)
  lineDiscounts     Decimal  @db.Decimal(12, 2)
  discountAmount    Decimal  @db.Decimal(12, 2)
  discountReason    String?
  vatRate           Decimal  @db.Decimal(5, 2)
  vatAmount         Decimal  @db.Decimal(12, 2)
  // The organisation's TIN, when VAT was charged.
  vatNumber         String?
  total             Decimal  @db.Decimal(12, 2)
  amountPaidAtIssue Decimal  @db.Decimal(12, 2)
  // When payment is due: issuedAt + the customer's payment terms, for an
  // organisation on credit. Null = due before collection.
  dueDate           DateTime?
  // [{ description, type, quantity, unitOfMeasure, unitPrice, lineDiscount, amount, billTo }]
  lines             Json
  issuedAt          DateTime @default(now())
  issuedById        String
  createdAt         DateTime @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  branch       Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  jobCard      JobCard      @relation(fields: [jobCardId], references: [id], onDelete: Cascade)
  customer     Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  issuedBy     User         @relation("InvoiceIssuedBy", fields: [issuedById], references: [id])

  @@index([organisationId, issuedAt])
  @@index([branchId])
  @@index([customerId])
  @@map("invoices")
}

// The secure link a WhatsApp message carries to a
// customer document (WhatsApp cannot attach a file from a link). The staff
// portal's /d/<token> opens the PDF, drawn from the live record, without
// signing in. The token is 32 random bytes (base64url), only in the
// message; only its SHA-256 (hex) is kept. 30 days; can be revoked.
// recordId: the Job Card (ESTIMATE, INVOICE) or the payment (RECEIPT).
enum DocumentLinkKind {
  ESTIMATE
  INVOICE
  RECEIPT
}

model DocumentLink {
  id             String           @id @default(cuid())
  organisationId String
  kind           DocumentLinkKind
  recordId       String
  tokenHash      String           @unique
  expiresAt      DateTime
  revokedAt      DateTime?
  createdById    String
  createdAt      DateTime         @default(now())
  openCount      Int              @default(0)
  lastOpenedAt   DateTime?

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  createdBy    User         @relation("DocumentLinkCreatedBy", fields: [createdById], references: [id])

  @@index([organisationId, kind, recordId])
  @@map("document_links")
}

// A cancellation request does not change JobCard.status until a Manager
// approves it, so a decline has nothing to revert. A Job Card may have
// several requests over time. The requester's reason is required; the
// Manager's decision note is recorded either way.
enum CancellationRequestStatus {
  PENDING
  APPROVED
  DECLINED
}

model CancellationRequest {
  id            String                    @id @default(cuid())
  jobCardId     String
  reason        String
  requestedById String
  requestedAt   DateTime                  @default(now())
  status        CancellationRequestStatus @default(PENDING)
  decidedById   String?
  decidedAt     DateTime?
  decisionNotes String?
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @default(now()) @updatedAt

  jobCard     JobCard @relation(fields: [jobCardId], references: [id], onDelete: Cascade)
  requestedBy User    @relation("CancellationRequestedBy", fields: [requestedById], references: [id])
  decidedBy   User?   @relation("CancellationDecidedBy", fields: [decidedById], references: [id])

  @@index([jobCardId, status])
  @@map("cancellation_requests")
}

// Same request → Manager decision shape as CancellationRequest: status
// only becomes CLOSED on approval. No reason field (closing needs no
// justification).
model CloseRequest {
  id            String                    @id @default(cuid())
  jobCardId     String
  requestedById String
  requestedAt   DateTime                  @default(now())
  status        CancellationRequestStatus @default(PENDING)
  decidedById   String?
  decidedAt     DateTime?
  decisionNotes String?
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @default(now()) @updatedAt

  jobCard     JobCard @relation(fields: [jobCardId], references: [id], onDelete: Cascade)
  requestedBy User    @relation("CloseRequestedBy", fields: [requestedById], references: [id])
  decidedBy   User?   @relation("CloseDecidedBy", fields: [decidedById], references: [id])

  @@index([jobCardId, status])
  @@map("close_requests")
}

// ----------------------------------------------------------------------------
// VEHICLE SERVICE: a lighter workflow than Job Card for routine maintenance
// and minor requested work (oil changes, filters, brake adjustment, AC gas).
// A repair found mid-service is escalated to a Job Card (escalatedToJobCardId).
// Uses the same Customer and CustomerVehicle records as Job Cards.
// ----------------------------------------------------------------------------

// Every service-due reminder sent for a vehicle. Per vehicle, not per
// service, since a reminder is about the vehicle's next due point. The
// figures shown to the customer are stored as they were at send time,
// because mileage and predictions change afterwards.
model ServiceReminderLog {
  id                     String   @id @default(cuid())
  vehicleId              String
  vehicle                CustomerVehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  // 1 = friendly, 2 = follow-up, 3 = due, 4+ = overdue. Stored rather than
  // derived from sentAt, since stages can be skipped or the interval changed.
  reminderNumber         Int
  sentAt                 DateTime @default(now())
  estimatedDueOdometer   Int?
  estimatedDueDate       DateTime?
  recordedOdometerAtSend Int?
  trigger                String
  deliveryStatus         String   @default("SENT")

  @@map("service_reminder_logs")
}

// One multi-point inspection per Job Card: what the technician found at
// check-in, item by item, before the estimate is written.
model VehicleInspection {
  id               String                  @id @default(cuid())
  jobCardId        String                  @unique
  inspectedById    String
  status           VehicleInspectionStatus @default(NOT_STARTED)
  startedAt        DateTime?
  completedAt      DateTime?
  // Set together on a skip; inspectedById is whoever decided to skip.
  skippedAt        DateTime?
  skipReason       String?
  notes            String?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  jobCard        JobCard        @relation(fields: [jobCardId], references: [id], onDelete: Cascade)
  inspectedBy    User           @relation("VehicleInspectionInspector", fields: [inspectedById], references: [id])
  items          VehicleInspectionItem[]

  @@map("vehicle_inspections")
}

// One row per checklist item, generated from the vehicle-type template
// (lib/vehicle-inspection-template.ts) when the inspection starts.
// condition/action are free text because the vocabulary differs per item
// ("Dirty" filter, "Low" oil, "Worn" pad); severity is the controlled value
// used for summaries.
model VehicleInspectionItem {
  id           String              @id @default(cuid())
  inspectionId String
  section      String              // e.g. "Engine & Lubrication"
  name         String              // e.g. "Engine Oil"
  condition    String?
  severity     InspectionSeverity?
  action       String?
  notes        String?
  updatedAt    DateTime            @updatedAt

  inspection VehicleInspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)

  @@unique([inspectionId, section, name])
  @@map("vehicle_inspection_items")
}

model CustomerAddress {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  // When it was added (audit trail and CRM ordering).
  createdAt  DateTime @default(now())

  label      String? // "Home", "Office"
  line1      String
  line2      String?
  city       String?
  state      String?
  country    String?

  @@index([customerId])
  @@map("customer_addresses")
}

model CustomerContact {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  name  String
  phone String?
  email String?
  role  String? // e.g. "Fleet Manager"
  createdAt DateTime @default(now())

  @@index([customerId])
  @@map("customer_contacts")
}

// ----------------------------------------------------------------------------
// BETTER AUTH TABLES
// Standard Better Auth schema (https://www.better-auth.com/docs/concepts/database).
// Field names are set by the library's Prisma adapter; keep them in step with
// apps/portal/lib/auth.ts. Staff and customer sessions live in separate tables,
// so a customer token can never be presented to a staff-only guard.
// ----------------------------------------------------------------------------

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("sessions")
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId             String
  providerId            String    // "credential", "google", "microsoft"...
  password              String?   // password hash for the "credential" provider; Better Auth's field name, keep it
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@map("accounts")
}

model CustomerSession {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  token      String   @unique
  expiresAt  DateTime
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("customer_sessions")
}

model CustomerAccount {
  id                    String    @id @default(cuid())
  customerId            String
  customer              Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  accountId             String
  providerId            String
  password              String?   // same field-name requirement as Account.password above
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@map("customer_accounts")
}

// Staff verification rows (email verification, password reset). Keyed by
// (identifier, value), not by user. Customer links use CustomerVerification.
model Verification {
  id         String   @id @default(cuid())
  identifier String   // typically the email being verified/reset
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  // Better Auth writes updatedAt on every verification (password-reset
  // and set-password links), so the column is required.
  updatedAt  DateTime @default(now()) @updatedAt

  @@index([identifier])

  @@map("verifications")
}

/// The customer portal's own reset / set-password links. Kept apart
/// from staff `verifications` so a customer link can never be redeemed on the
/// staff portal (or the reverse), whatever the token.
model CustomerVerification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@index([identifier])
  @@map("customer_verifications")
}

/// A note staff keep on a customer (calls, preferences, follow-ups).
/// Never shown to the customer.
model CustomerNote {
  id         String   @id @default(cuid())
  customerId String
  authorId   String
  body       String
  pinned     Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  author   User     @relation("CustomerNoteAuthor", fields: [authorId], references: [id])

  @@index([customerId, createdAt])
  @@map("customer_notes")
}

/// What a customer has read in their portal notifications
/// ("bc:<broadcastId>", "jc:<id>:<event>", …).
model CustomerNotificationRead {
  id         String   @id @default(cuid())
  customerId String
  key        String
  readAt     DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([customerId, key])
  @@map("customer_notification_reads")
}

// ----------------------------------------------------------------------------
// AUDIT LOG: append-only, timestamped history every module writes to.
// ----------------------------------------------------------------------------
model AuditLog {
  id         String   @id @default(cuid())
  // Which organisation's history this row belongs to (stamped on every
  // write — see audit-journal.ts). Null only for the platform team's own
  // or unattributed system rows, which only the platform team sees.
  organisationId String?
  userId     String?
  action     String   // e.g. "user.created", "job_card.approved"
  entityType String   // e.g. "JobCard"
  entityId   String?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  // For the audit dashboard: a record's full history, a user's
  // activity, and date-range browsing — all indexed.
  @@index([entityType, entityId])
  @@index([userId])
  @@index([createdAt])
  // The activity feed reads "this kind of record, newest first" and "this
  // person's actions, newest first".
  @@index([entityType, createdAt])
  @@index([userId, createdAt])
  // Each organisation's audit trail and activity feed, newest first.
  @@index([organisationId, createdAt])
  @@map("audit_logs")
}

// ----------------------------------------------------------------------------
// DASHBOARD ANNOUNCEMENTS: messages written by a Master Admin or Manager,
// shown in the dashboard marquee. Separate from AuditLog because they are
// authored messages, not recorded events.
// ----------------------------------------------------------------------------

model Announcement {
  id        String   @id @default(cuid())
  organisationId String
  message   String
  // After this the announcement stops showing (e.g. a notice about Friday's
  // stock count). Null means active until switched off.
  expiresAt DateTime?
  isActive  Boolean  @default(true)

  createdById String
  createdAt   DateTime @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  createdBy    User         @relation("AnnouncementCreatedBy", fields: [createdById], references: [id])

  @@map("announcements")
}

// ----------------------------------------------------------------------------
// STORE / INVENTORY: part catalogue, units of measure, stock and goods
// receipts.
//
// Three tracking types:
//   QUANTITY   — a single running total, e.g. brake pads, filters, WD-40.
//   BATCH      — stock grouped by delivery, e.g. engine oil, coolant, brake
//                fluid, so a bad batch can be traced to the vehicles that
//                received it without serialising every bottle.
//   SERIALIZED — each physical unit has its own identity, e.g. tyres, rims.
//
// Stock is held in one base unit (e.g. litres); a delivery can be recorded
// in the unit it arrived in (a drum, a case) and is converted.
// ----------------------------------------------------------------------------

enum PartTrackingType {
  QUANTITY
  BATCH
  SERIALIZED
}

enum PartSerialStatus {
  IN_STOCK
  ISSUED
}

model Part {
  id          String @id @default(cuid())
  branchId    String
  name        String
  description String?
  // Free-text browsing category used by the catalogue search. Structured
  // classification is partTypeId below.
  category    String?
  // Internal reference code. `barcode` below is reserved for barcode scanning.
  partNumber  String?
  barcode     String?
  trackingType PartTrackingType @default(QUANTITY)
  // The unit stock is held in (e.g. "Liter" for engine oil, "Each" for brake
  // pads). Alternative units convert to this one.
  baseUnitOfMeasure String
  // Reorder point and safety stock, set by Store (usually from the inventory
  // analytics suggestion).
  reorderPoint Decimal? @db.Decimal(12, 3)
  safetyStock  Decimal? @db.Decimal(12, 3)
  // Price charged to customers per base unit, set by Store. Separate from the
  // goods receipt cost (what was paid). Store matching requires it and never
  // falls back to cost.
  sellingPrice Decimal? @db.Decimal(12, 2)
  // The margin Store wants on this part, as a percentage of sellingPrice
  // (30 = cost at most 70% of price). Null means not set yet, not 0%; the
  // Pricing Command Center skips parts without one.
  targetMarginPercent Decimal? @db.Decimal(5, 2)
  // Whether the target is entered and shown as margin or markup.
  // targetMarginPercent always stores margin.
  pricingMethod PricingMethod @default(MARGIN)
  isActive     Boolean  @default(true)
  // The generic part type this part is (e.g. "Fuel Filter"), so a technician's
  // request for a type can match every vehicle-specific part of that type.
  // Separate from the free-text `category` browsing field.
  partTypeId   String?
  // The part's number in another system (QuickBooks or an old spreadsheet):
  // externalSource is where from, externalId the item number there. Unique
  // per branch and source.
  externalSource String?
  externalId     String?
  // The import that created this part (Data Exchange): Undo moves exactly these to the Recycle bin.
  importJobId    String?
  createdById  String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  createdBy User     @relation("PartCreatedBy", fields: [createdById], references: [id])
  partType  PartType? @relation(fields: [partTypeId], references: [id])

  alternativeUnits  PartUnitOfMeasure[]
  stock             PartStock?
  batches           PartBatch[]
  serials           PartSerial[]
  goodsReceiptLines GoodsReceiptLine[]
  requestSlipLines  PartRequestSlipLine[]
  // Release trail for QUANTITY parts (which request took how much).
  quantityConsumptions PartQuantityConsumption[]
  fitments          PartFitment[]
  matchedOnEstimateLines EstimateLineItem[] @relation("EstimateLineItemMatchedPart")
  pricingAlerts     PricingAlert[]

  @@unique([branchId, partNumber])
  @@unique([branchId, externalSource, externalId])
  @@index([externalId])
  @@index([importJobId])
  @@map("parts")
}

// An alternative unit a delivery may arrive in and its factor to the base
// unit, e.g. "Drum" with conversionFactor 200 for a part in litres.
model PartUnitOfMeasure {
  id               String  @id @default(cuid())
  partId           String
  unitName         String
  conversionFactor Decimal @db.Decimal(12, 4)

  part Part @relation(fields: [partId], references: [id], onDelete: Cascade)

  @@unique([partId, unitName])
  @@map("part_units_of_measure")
}

// The current stock total for a part: the stock figure for QUANTITY parts,
// and a running total for BATCH/SERIALIZED parts (detail in PartBatch /
// PartSerial) so nothing has to sum batches or serials.
model PartStock {
  id               String   @id @default(cuid())
  partId           String   @unique
  quantityOnHand   Decimal  @default(0) @db.Decimal(14, 4)
  // Quantity reserved by approved parts requests, so a later request can't be
  // promised the same stock before the first is released.
  quantityReserved Decimal  @default(0) @db.Decimal(14, 4)
  updatedAt        DateTime @updatedAt

  part Part @relation(fields: [partId], references: [id], onDelete: Cascade)

  @@map("part_stock")
}

// One row per delivery batch of a BATCH part, e.g. "one 200 L drum received
// on 2026-08-29, 152 L left". remainingQuantity goes down on release;
// receivedQuantity never changes.
model PartBatch {
  id                 String    @id @default(cuid())
  partId             String
  batchNumber        String
  receivedQuantity   Decimal   @db.Decimal(14, 4)
  remainingQuantity  Decimal   @db.Decimal(14, 4)
  receivedAt         DateTime  @default(now())
  expiryDate         DateTime?
  goodsReceiptLineId String?

  part             Part              @relation(fields: [partId], references: [id], onDelete: Cascade)
  goodsReceiptLine GoodsReceiptLine? @relation(fields: [goodsReceiptLineId], references: [id])
  // Draws against this batch. Many-to-many: a release can draw from several
  // batches (FIFO) and a batch can serve several releases.
  consumptions     PartBatchConsumption[]

  @@unique([partId, batchNumber])
  @@map("part_batches")
}

// Which batch a released quantity came from, so a faulty delivery can be
// traced to the customers and vehicles that received it.
model PartBatchConsumption {
  id            String   @id @default(cuid())
  batchId       String
  slipLineId    String
  quantityTaken Decimal  @db.Decimal(14, 4)
  consumedAt    DateTime @default(now())

  batch    PartBatch           @relation(fields: [batchId], references: [id], onDelete: Cascade)
  slipLine PartRequestSlipLine @relation(fields: [slipLineId], references: [id], onDelete: Cascade)

  @@index([batchId])
  @@index([slipLineId])
  @@index([consumedAt])
  @@map("part_batch_consumptions")
}

// Release trail for QUANTITY parts (no batch or serial rows): which
// request took how much.
model PartQuantityConsumption {
  id            String   @id @default(cuid())
  partId        String
  slipLineId    String
  quantityTaken Decimal  @db.Decimal(14, 4)
  consumedAt    DateTime @default(now())
  // The goods receipt line this release drew from, so QUANTITY releases trace
  // back to a GRN like batches and serials. A release spanning two deliveries
  // is two rows, FIFO (lib/inventory/quantity-fifo.ts). Null on older
  // releases, which are attributed oldest-first at display time.
  goodsReceiptLineId String?

  part             Part                @relation(fields: [partId], references: [id], onDelete: Cascade)
  slipLine         PartRequestSlipLine @relation(fields: [slipLineId], references: [id], onDelete: Cascade)
  goodsReceiptLine GoodsReceiptLine?   @relation(fields: [goodsReceiptLineId], references: [id])

  @@index([partId])
  @@index([goodsReceiptLineId])
  @@index([slipLineId])
  @@index([consumedAt])
  @@map("part_quantity_consumptions")
}

// One row per physical unit of a SERIALIZED part (e.g. one tyre). status
// becomes ISSUED on release; serials are never deleted.
model PartSerial {
  id                 String           @id @default(cuid())
  partId             String
  serialNumber       String
  status             PartSerialStatus @default(IN_STOCK)
  receivedAt         DateTime         @default(now())
  goodsReceiptLineId String?
  // The request line this unit was issued against, for tracing a faulty unit. A
  // single link is enough because a unit is issued once (there is no
  // returns flow).
  issuedToSlipLineId String?

  part             Part                 @relation(fields: [partId], references: [id], onDelete: Cascade)
  goodsReceiptLine GoodsReceiptLine?    @relation(fields: [goodsReceiptLineId], references: [id])
  issuedToSlipLine PartRequestSlipLine? @relation(fields: [issuedToSlipLineId], references: [id])

  // Unique across all parts, not per part: a serial identifies one physical
  // unit in the whole catalogue.
  @@unique([serialNumber])
  @@index([partId, status])
  @@index([issuedToSlipLineId])
  @@index([goodsReceiptLineId])
  @@map("part_serials")
}

// A delivery into the store. Numbered GRN-2026-000001, like Job Card numbers.
model GoodsReceipt {
  id              String   @id @default(cuid())
  // One per submitted form (see components/IdempotencyKey.tsx): the same
  // delivery resent after a dropped connection can never add stock twice.
  idempotencyKey  String?  @unique
  branchId        String
  referenceNumber String   @unique
  supplierName    String
  // The supplier from the organisation's supplier list, when the name matches one (the name stays as typed).
  supplierId      String?
  receivedById    String
  receivedAt      DateTime @default(now())
  notes           String?
  // The stock a branch already held when it started with EJO, brought in by an import (Data Exchange):
  // an opening-balance receipt dated at the cut-over, so FIFO costs, stock value and the inventory analytics
  // include it like any delivery. importJobId: the import that made it (its reversal removes exactly these).
  isOpeningBalance Boolean @default(false)
  importJobId     String?
  createdAt       DateTime @default(now())

  supplier   Supplier?          @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  branch     Branch             @relation(fields: [branchId], references: [id], onDelete: Cascade)
  receivedBy User               @relation("GoodsReceiptReceivedBy", fields: [receivedById], references: [id])
  lines      GoodsReceiptLine[]

  @@index([branchId, receivedAt])
  @@index([importJobId])
  @@index([supplierId])
  @@map("goods_receipts")
}

// One line per part on a delivery. quantityReceivedInUnit and unitUsed are
// what the storekeeper entered (e.g. "1 Drum"); quantityInBaseUnit is what
// was added to stock (e.g. "200 Liters"). Both are kept.
model GoodsReceiptLine {
  id                     String   @id @default(cuid())
  goodsReceiptId         String
  partId                 String
  quantityReceivedInUnit Decimal  @db.Decimal(14, 4)
  unitUsed               String
  quantityInBaseUnit     Decimal  @db.Decimal(14, 4)
  // Exact amount paid for the delivery line, from the typed figures. Never
  // recomputed from unitCost: ₦650,000 ÷ 205 L has no exact 2-decimal answer,
  // and multiplying the rounded unit cost back out shows ₦649,999.65.
  totalCost              Decimal? @db.Decimal(14, 2)
  // Cost per base unit, for pricing calculations and "₦X/Liter" notes.
  // Derived, not the record of what was paid. Six decimal places keep
  // rounding errors below a kobo.
  unitCost               Decimal? @db.Decimal(16, 6)
  // Only meaningful for a BATCH-tracked part — the batch this line
  // creates or adds to.
  batchNumber            String?

  goodsReceipt GoodsReceipt @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  part         Part         @relation(fields: [partId], references: [id])
  batches      PartBatch[]
  serials      PartSerial[]
  quantityConsumptions PartQuantityConsumption[]
  pricingAlert PricingAlert?

  @@index([goodsReceiptId])
  @@index([partId])
  @@map("goods_receipt_lines")
}

// ----------------------------------------------------------------------------
// PRICING COMMAND CENTER: each goods receipt line for a part with both a
// sellingPrice and a targetMarginPercent is compared against the new cost
// when it is recorded (recordGoodsReceipt). Parts missing either are skipped.
// ----------------------------------------------------------------------------

// How the target is entered and shown. Part.targetMarginPercent always
// stores margin (profit ÷ selling price); a part priced by markup
// (profit ÷ cost) shows and accepts markup, converted both ways. Typing a
// markup figure into a margin field would ask for a higher target.
enum PricingMethod {
  MARGIN
  MARKUP
}

enum PricingAlertSeverity {
  // Margin is below target but still positive.
  DEFICIT
  // Cost has fallen; margin is now well above target. An opportunity, flagged
  // so it isn't missed.
  BOOST
  // Cost exceeds sellingPrice: every sale loses money. Store matching refuses
  // the part while this alert is open.
  CRITICAL_LOSS
}

enum PricingAlertStatus {
  OPEN
  // Store changed sellingPrice (or the target) in response, e.g. via "Sync
  // Price". DISMISSED means the current price was kept on purpose.
  RESOLVED
  DISMISSED
}

model PricingAlert {
  id       String @id @default(cuid())
  partId   String
  // The delivery that raised this alert.
  goodsReceiptLineId String @unique
  severity PricingAlertSeverity
  status   PricingAlertStatus @default(OPEN)

  // Figures as they were when the alert was raised, since sellingPrice and
  // the target may change later.
  previousUnitCost   Decimal? @db.Decimal(16, 6)
  newUnitCost        Decimal @db.Decimal(16, 6)
  sellingPriceAtAlert Decimal @db.Decimal(12, 2)
  targetMarginPercentAtAlert Decimal @db.Decimal(5, 2)
  actualMarginPercent Decimal @db.Decimal(6, 2)

  resolvedById String?
  resolvedAt   DateTime?
  resolutionNotes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  part            Part             @relation(fields: [partId], references: [id], onDelete: Cascade)
  goodsReceiptLine GoodsReceiptLine @relation(fields: [goodsReceiptLineId], references: [id], onDelete: Cascade)
  resolvedBy      User?            @relation("PricingAlertResolvedBy", fields: [resolvedById], references: [id])

  @@index([partId, status])
  @@map("pricing_alerts")
}

// ----------------------------------------------------------------------------
// PARTS REQUEST SLIP & EXTERNAL PROCUREMENT: the two sourcing paths for an
// estimate, chosen from its line types (STORE_PART vs EXTERNAL_PART /
// EXTERNAL_JOB). A job may need one, both or neither.
// Both open once the job reaches IN_PROGRESS (deposit paid).
// ----------------------------------------------------------------------------

enum PartRequestSlipStatus {
  PENDING_HOD_APPROVAL
  PENDING_STORE_APPROVAL
  APPROVED
  RELEASED
  REJECTED
}

// Store parts: the Workshop HOD approves the request, Store approves and
// reserves the stock (PartStock.quantityReserved, so a later request can't
// be promised the same units), and a storekeeper releases it.
// Numbered PRS-2026-000001.
model PartRequestSlip {
  id              String                @id @default(cuid())
  referenceNumber String                @unique
  // Exactly one of jobCardId / vehicleServiceId is set, enforced in the app
  // (Prisma can't express a CHECK constraint).
  jobCardId       String?
  branchId        String
  requestedById   String
  status          PartRequestSlipStatus @default(PENDING_HOD_APPROVAL)

  hodApprovedById String?
  hodApprovedAt   DateTime?
  hodNotes        String?

  storeApprovedById String?
  storeApprovedAt   DateTime?
  storeNotes        String?

  releasedById String?
  releasedAt   DateTime?
  // Who collected the parts: a user where possible, or a typed name (e.g. an
  // intern without an account). One collector per slip.
  receivedByUserId String?
  receivedByName   String?

  rejectedById    String?
  rejectedAt      DateTime?
  // HOD or STORE: which stage rejected it, stated rather than inferred from
  // timestamps.
  rejectionStage  String?
  rejectionReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  jobCard        JobCard?  @relation(fields: [jobCardId], references: [id], onDelete: Cascade)
  branch         Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  requestedBy    User     @relation("PartRequestSlipRequestedBy", fields: [requestedById], references: [id])
  hodApprovedBy  User?    @relation("PartRequestSlipHodApprovedBy", fields: [hodApprovedById], references: [id])
  storeApprovedBy User?   @relation("PartRequestSlipStoreApprovedBy", fields: [storeApprovedById], references: [id])
  releasedBy     User?    @relation("PartRequestSlipReleasedBy", fields: [releasedById], references: [id])
  receivedByUser User?    @relation("PartRequestSlipReceivedBy", fields: [receivedByUserId], references: [id])
  rejectedBy     User?    @relation("PartRequestSlipRejectedBy", fields: [rejectedById], references: [id])
  lines          PartRequestSlipLine[]

  @@index([branchId, status])
  @@index([jobCardId])
  @@map("part_request_slips")
}

model PartRequestSlipLine {
  id                 String   @id @default(cuid())
  slipId             String
  partId             String
  // The Job Card estimate line this line sources.
  estimateLineItemId String?
  // The Service Estimate line this line sources. Never set together with
  // estimateLineItemId.
  // In the part's base unit; reservation and release use the base unit.
  quantityRequested  Decimal  @db.Decimal(14, 4)
  quantityReleased   Decimal? @db.Decimal(14, 4)

  slip             PartRequestSlip   @relation(fields: [slipId], references: [id], onDelete: Cascade)
  part             Part              @relation(fields: [partId], references: [id])
  estimateLineItem EstimateLineItem? @relation(fields: [estimateLineItemId], references: [id])
  // What this line was released with: batch quantities and serials.
  batchConsumptions PartBatchConsumption[]
  issuedSerials     PartSerial[]
  quantityConsumptions PartQuantityConsumption[]

  @@index([slipId])
  @@index([partId])
  @@map("part_request_slip_lines")
}

// ----------------------------------------------------------------------------
// PART FITMENT: which vehicles a part fits. The compatibility key is the
// engine, not the model name: different models can share an engine (the
// Toyota Hilux and Fortuner both use the 2GD) and one model name can hide
// different engines. A many-to-many table expresses "fits two models but not a third".
//
// A part with no fitment rows fits everything (engine oil, coolant, brake
// fluid…).
// ----------------------------------------------------------------------------

model PartFitment {
  id     String @id @default(cuid())
  partId String
  make   String
  // Null means "fits every model of this make".
  model  String?
  // Null means "fits every engine of this make/model". Only set together
  // with model.
  engineType String?
  // Optional year range; null on either end means unbounded. Only set
  // together with model.
  yearFrom Int?
  yearTo   Int?

  createdAt DateTime @default(now())

  part Part @relation(fields: [partId], references: [id], onDelete: Cascade)

  @@map("part_fitments")
}

// ----------------------------------------------------------------------------
// PART CATEGORY / PART TYPE: the two-level list technicians browse when
// writing an estimate:
//
//   Filter (PartCategory)              Fluid (PartCategory)
//   ├── Oil Filter (PartType)          ├── Coolant (PartType)
//   └── Fuel Filter (PartType)         ├── Engine Oil (PartType)
//                                      └── Brake Fluid (PartType)
//
// The PartType ("Fuel Filter") is what appears on the estimate. One type can
// cover several vehicle-specific Parts ("Fuel Filter — Toyota Corolla",
// "Fuel Filter — Honda Accord"); the store picks the one that fits.
// Separate from the free-text Part.category browsing field.
// ----------------------------------------------------------------------------

model PartCategory {
  id          String   @id @default(cuid())
  branchId    String
  name        String
  // Prefix for generated part numbers (e.g. "FIL" → FIL-001). Nullable for
  // older categories; required by the create form.
  code        String?
  description String?
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  branch    Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  createdBy User   @relation("PartCategoryCreatedBy", fields: [createdById], references: [id])

  partTypes PartType[]

  @@unique([branchId, name])
  @@unique([branchId, code])
  @@map("part_categories")
}

model PartType {
  id          String   @id @default(cuid())
  branchId    String
  categoryId  String
  name        String
  description String?
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  branch    Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  category  PartCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdBy User         @relation("PartTypeCreatedBy", fields: [createdById], references: [id])

  parts             Part[]
  estimateLineItems EstimateLineItem[]

  @@unique([branchId, categoryId, name])
  @@map("part_types")
}

// Who pays for a Job Card estimate line.
enum EstimateBillTo {
  CUSTOMER
  WARRANTY
  GOODWILL
  INTERNAL
}

// ─────────────────────────────────────────────────────────────────────────
// SECURITY: the gate. Vehicles cleared to leave the compound. Every step is
// audited and every email is logged (SecurityEmailLog), so nothing that
// happened at the gate is ever missing.
// ─────────────────────────────────────────────────────────────────────────

// A vehicle released by the workshop (its Job Card checked out) confirmed
// through the gate by security.
model VehicleGateExit {
  id               String   @id @default(cuid())
  exitNumber       String   @unique
  branchId         String
  jobCardId        String?  @unique
  vehicleId        String
  exitedAt         DateTime @default(now())
  exitedById       String
  driverName       String?
  notes            String?
  createdAt        DateTime @default(now())

  branch         Branch          @relation(fields: [branchId], references: [id])
  jobCard        JobCard?        @relation(fields: [jobCardId], references: [id])
  vehicle        CustomerVehicle @relation(fields: [vehicleId], references: [id])
  exitedBy       User            @relation("VehicleGateExitBy", fields: [exitedById], references: [id])

  @@map("vehicle_gate_exits")
}

// Every email the Security module sends — who, what, when, and whether
// it went — so a notice is never "maybe sent".
model SecurityEmailLog {
  id         String   @id @default(cuid())
  entityType String
  entityId   String
  recipient  String
  subject    String
  sent       Boolean
  error      String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@map("security_email_logs")
}

// ─────────────────────────────────────────────────────────────────────────

// ─────────────────────────────────────────────────────────────────────────
// NOTIFICATIONS & BROADCASTS
// ─────────────────────────────────────────────────────────────────────────
enum BroadcastCategory {
  NEWS
  ANNOUNCEMENT
  IMPORTANT
  URGENT
  SECURITY_ALERT
  MAINTENANCE
  GREETING
}

enum BroadcastAudience {
  ALL
  BRANCH
  DEPARTMENT
  ROLE
  // Messages to customers (portal dashboard + optional email):
  // every active customer of the organisation, or the customers in audienceIds.
  CUSTOMERS_ALL
  CUSTOMERS_SELECTED
}

/// A message to staff — dashboard, marquee, notification centre and
/// (optionally) email — live from startsAt to endsAt, then it switches
/// itself off (an admin can stop, reactivate or delete it).
model Broadcast {
  id              String            @id @default(cuid())
  broadcastNumber String            @unique
  organisationId  String
  category        BroadcastCategory
  title           String
  message         String
  audience        BroadcastAudience @default(ALL)
  // Branch / department ids or role slugs, per the audience.
  audienceIds     String[]          @default([])
  startsAt        DateTime
  // Null = runs until stopped.
  endsAt          DateTime?
  durationLabel   String?
  sendEmail       Boolean           @default(false)
  emailedAt       DateTime?
  isActive        Boolean           @default(true)
  stoppedAt       DateTime?
  stoppedById     String?
  createdById     String
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @default(now()) @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  createdBy    User         @relation("BroadcastCreatedBy", fields: [createdById], references: [id])
  stoppedBy    User?        @relation("BroadcastStoppedBy", fields: [stoppedById], references: [id])

  @@index([isActive, startsAt])
  @@index([organisationId, updatedAt])
  @@map("broadcasts")
}

/// What a person has read in their notification centre: "audit:<id>"
/// for activity, "bc:<id>" for broadcasts.
model NotificationRead {
  id     String   @id @default(cuid())
  userId String
  key    String
  readAt DateTime @default(now())

  user User @relation("NotificationReads", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@map("notification_reads")
}

model NotificationPreference {
  userId    String   @id
  muted     Boolean  @default(false)
  updatedAt DateTime @default(now()) @updatedAt

  user User @relation("NotificationPreference", fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

/// Every unexpected error a person sees carries a short reference
/// ("quote reference 3553129217"). The reference, where it happened and a
/// secret-free summary are kept here so IT can look it up on the Error log
/// page instead of searching server logs.
model ErrorEvent {
  id             String   @id @default(cuid())
  ref            String
  app            String
  organisationId String?
  userId         String?
  customerId     String?
  method         String?
  path           String?
  route          String?
  kind           String?
  name           String?
  message        String
  stack          String?
  createdAt      DateTime @default(now())

  @@index([ref])
  @@index([organisationId, createdAt])
  @@index([createdAt])
  @@map("error_events")
}

/// Recycle bin. A record created by mistake (a Job Card opened on the
/// wrong vehicle, a duplicate customer) is moved here while nothing of
/// consequence has happened to it: no payment, no approved estimate, no parts,
/// no gate exit. The live rows are deleted in the same
/// transaction, and `snapshot` keeps every deleted row (parent first) so the
/// organisation's administrators can restore it exactly within the retention
/// period. After `purgeAfter` the platform's clean-up removes the snapshot;
/// this row stays as a short tombstone (reference, who, when, why).
/// Records with business consequences are never deleted: they are cancelled
/// or closed through their own workflow.
model RecycleBinItem {
  id                String    @id @default(cuid())
  organisationId    String
  // The branch of a branch-owned record (Job Card, part);
  // null for customers and vehicles, which belong to the organisation.
  branchId          String?
  // JobCard | Customer | CustomerVehicle | Part
  entityType        String
  entityId          String
  // The human reference without personal details ("JC-2026-000123").
  reference         String
  // What people see in the bin ("JC-2026-000123 · Toyota Hilux KJA-219-XY · Ada Okafor").
  label             String
  reason            String
  // { v: 1, rows: [{ model, data }] } in insert order. Null once purged or restored.
  snapshot          Json?
  deletedById       String
  deletedAt         DateTime  @default(now())
  purgeAfter        DateTime
  restoredAt        DateTime?
  restoredById      String?
  // The reference it came back under, when the old one had been reused.
  restoredReference String?
  purgedAt          DateTime?
  purgedById        String?

  @@index([organisationId, deletedAt])
  @@index([entityType, entityId])
  @@index([purgeAfter])
  @@map("recycle_bin_items")
}

// ═══════════════════════════════════════════════════════════════════════
// Enyo 1.0 (AI), support tickets, reminders, mailbox. Additive only.
// Ids of people and records are plain strings (no foreign keys to existing
// tables), like ErrorEvent and RecycleBinItem, so nothing existing changes.
// ═══════════════════════════════════════════════════════════════════════

/// Per-organisation switches for Enyo. No row = defaults (everything on, predictions in shadow).
model EnyoSetting {
  organisationId    String   @id
  // Master switch: off = every Enyo feature hidden; the ERP works as before.
  enabled           Boolean  @default(true)
  staffAssistant    Boolean  @default(true)
  customerAssistant Boolean  @default(true)
  publicAssistant   Boolean  @default(true)
  // Display name and greeting shown to staff and customers (branding).
  displayName       String   @default("Enyo")
  // Learn only from records opened on or after this day (Lagos). Set it
  // to the go-live date so test data typed while trying the system out is
  // never learned from. Null = all history (up to three years).
  learnFrom         DateTime? @db.Date
  updatedById       String?
  updatedAt         DateTime @updatedAt

  @@map("enyo_settings")
}

enum EnyoChannel {
  STAFF
  CUSTOMER
  PUBLIC
}

enum EnyoMessageRole {
  USER
  ASSISTANT
  TOOL
}

/// One chat thread. Staff: userId. Customer portal: customerId. Public website: visitorKey (random, no personal data).
model EnyoConversation {
  id             String            @id @default(cuid())
  organisationId String
  channel        EnyoChannel
  userId         String?
  customerId     String?
  visitorKey     String?
  title          String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  archivedAt     DateTime?
  messages       EnyoMessage[]

  @@index([userId, updatedAt])
  @@index([customerId, updatedAt])
  @@index([visitorKey, updatedAt])
  @@index([organisationId, createdAt])
  // Daily clean-up by channel and age.
  @@index([channel, updatedAt])
  @@index([archivedAt])
  @@map("enyo_conversations")
}

model EnyoMessage {
  id             String           @id @default(cuid())
  conversationId String
  conversation   EnyoConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           EnyoMessageRole
  content        String
  // ASSISTANT: the tool calls it asked for. TOOL: the tool's name (result kept short, redacted).
  toolName       String?
  toolCalls      Json?
  // { sources: [{ label, href }] } shown under an answer.
  citations      Json?
  model          String?
  tokensIn       Int?
  tokensOut      Int?
  latencyMs      Int?
  // 1 = helpful, -1 = not helpful, from the person who asked.
  rating         Int?
  ratingNote     String?
  // Public website only: a salted hash of the visitor's address, for rate limits. Never the address itself.
  ipHash         String?
  createdAt      DateTime         @default(now())

  @@index([conversationId, createdAt])
  @@index([ipHash, createdAt])
  @@map("enyo_messages")
}

/// Facts a staff member asked Enyo to remember ("call me Ada"). Theirs only; visible and deletable by them.
model EnyoMemory {
  id             String   @id @default(cuid())
  organisationId String
  userId         String
  fact           String
  createdAt      DateTime @default(now())

  @@index([userId, createdAt])
  @@map("enyo_memories")
}

enum SupportTicketStatus {
  OPEN
  WAITING_ON_CUSTOMER
  // Waiting on someone else (manufacturer, supplier, insurer); the customer sees "With our team".
  ON_HOLD
  RESOLVED
  CLOSED
}

enum SupportChannel {
  CUSTOMER_PORTAL
  WEBSITE
  // An email to a support address (support@, service@ …).
  EMAIL
  // Opened by a colleague (a phone call, a walk-in).
  STAFF
  // Logged by a colleague from a WhatsApp message, a call or a visit.
  WHATSAPP
  PHONE
  WALK_IN
  // Opened by a low "How did we do?" rating.
  RATING
}

/// A customer or website visitor handed over from Enyo to the company's people.
model SupportTicket {
  id              String              @id @default(cuid())
  organisationId  String
  branchId        String?
  // SUP-2026-000001
  number          String              @unique
  channel         SupportChannel
  customerId      String?
  contactName     String
  contactPhone    String?
  contactEmail    String?
  subject         String
  // Enyo's hand-over summary for the person picking it up.
  summary         String
  // The Enyo conversation holding the transcript.
  conversationId  String?
  status          SupportTicketStatus @default(OPEN)
  assignedToId    String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  firstResponseAt DateTime?
  resolvedAt      DateTime?
  replies         SupportReply[]

  // ── The Support centre ─────────────────────────────────────────
  // Which team (queue) owns it, and the address it came in to / goes out from.
  queueId          String?
  mailboxId        String?
  // URGENT | HIGH | NORMAL | LOW
  priority         String    @default("NORMAL")
  // What it is about (Enyo's triage or a colleague's choice) and how it reads.
  topic            String?
  sentiment        String?
  language         String?
  tags             String[]  @default([])
  // Plates, VINs and record numbers found in the messages (linked on the ticket page).
  entities         Json?
  // The sender proved to be the customer (signed in, or the email passed DMARC
  // and matches the customer's address). Only then may records be discussed.
  verified         Boolean   @default(false)
  // The email's sender domain proved the address (DMARC, or SPF and DKIM).
  // Enyo answers an email by itself only then (a forged sender never gets an AI reply).
  authenticatedSender Boolean @default(false)
  // Unguessable; the customer's "solved / talk to a person / rate us" page.
  token            String?   @unique
  // Service targets, worked out in business hours when the ticket opens.
  dueFirstResponseAt DateTime?
  dueResolutionAt  DateTime?
  slaWarnedAt      DateTime?
  slaBreachedAt    DateTime?
  lastCustomerAt   DateTime?
  lastAgentAt      DateTime?
  pendingSince     DateTime?
  nudgeCount       Int       @default(0)
  reopenCount      Int       @default(0)
  closedAt         DateTime?
  // Why a person was needed (customer_asked, low_confidence, sensitive, …).
  handoverReason   String?
  // ANSWERED (Enyo replied) → CONFIRMED (customer said solved) | ASSUMED (no
  // further question) | ESCALATED (asked for a person) — the AI resolution measures.
  aiOutcome        String?
  aiAnsweredAt     DateTime?
  // Waiting for Enyo to read it (triage, then an answer or a draft) — done
  // by the scheduled run, so taking in mail stays fast.
  aiPendingAt      DateTime?
  csatScore        Int?
  csatComment      String?
  csatAt           DateTime?
  csatRequestedAt  DateTime?
  // The email that opened it (Message-ID), for threading replies.
  sourceMessageId  String?
  // REQUEST (a question or request) or COMPLAINT (something went wrong): a
  // complaint carries its category and, when known, the job and vehicle.
  kind             String    @default("REQUEST")
  complaintCategory String?
  jobCardId        String?
  vehicleId        String?
  // Who is writing, as the Support centre recognised them from their
  // address or session: customer | staff | both (a colleague who is also a
  // customer) | unknown. And the colleague, when it is one.
  senderKind       String?
  senderUserId     String?
  // A colleague's own request for help (Get help in the portal): only
  // that colleague, the help queue's members and support managers see it.
  requesterUserId  String?

  @@index([requesterUserId, createdAt])
  @@index([organisationId, status, createdAt])
  @@index([customerId, createdAt])
  @@index([organisationId, queueId, status])
  @@index([status, dueFirstResponseAt])
  @@index([sourceMessageId])
  @@index([aiPendingAt])
  @@index([organisationId, kind, status])
  @@index([jobCardId])
  @@map("support_tickets")
}

/// A support team and its address(es): General, Customer care, Technical,
/// Parts … Each has its own targets and AI reply mode.
model SupportQueue {
  id             String   @id @default(cuid())
  organisationId String
  name           String
  // general | technical | customer_care | parts | other
  kind           String   @default("general")
  description    String?
  // A branch's own queue (null: the whole organisation).
  branchId       String?
  isDefault      Boolean  @default(false)
  active         Boolean  @default(true)
  // OFF: people only · SUGGEST: Enyo drafts, people send · AUTO: Enyo answers
  // general questions itself when it is confident; everything else goes to people.
  aiMode         String   @default("SUGGEST")
  autoAcknowledge Boolean @default(true)
  // The team's own words in its automatic reply (opening times, what
  // to include, an emergency number), shown above the reference and target.
  ackMessage     String?
  // Minutes per priority: { URGENT: { first, resolve }, … } (defaults when null).
  targets        Json?
  signature      String?
  createdById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  members        SupportQueueMember[]
  mailboxes      SupportMailbox[]

  @@unique([organisationId, name])
  @@index([organisationId, active])
  @@map("support_queues")
}

/// Who works a queue, how many open tickets they take, and whether they are away.
model SupportQueueMember {
  queueId        String
  queue          SupportQueue @relation(fields: [queueId], references: [id], onDelete: Cascade)
  userId         String
  organisationId String
  capacity       Int      @default(15)
  away           Boolean  @default(false)
  // A team lead is emailed when nobody on the team can take a new
  // request (all away or full) and when a request misses its target.
  isLead         Boolean  @default(false)
  lastAssignedAt DateTime?
  createdAt      DateTime @default(now())

  @@id([queueId, userId])
  @@index([organisationId, userId])
  @@map("support_queue_members")
}

/// A shared support mailbox (support@, service@ …): read for new
/// mail on a schedule, replies sent from it. The password is encrypted
/// (AES-256-GCM, MAILBOX_ENCRYPTION_KEY) and never shown or logged.
model SupportMailbox {
  id             String   @id @default(cuid())
  organisationId String
  queueId        String
  queue          SupportQueue @relation(fields: [queueId], references: [id], onDelete: Cascade)
  address        String
  displayName    String?
  imapHost       String
  imapPort       Int
  imapSecure     Boolean  @default(true)
  smtpHost       String
  smtpPort       Int
  smtpSecure     Boolean  @default(true)
  username       String
  secret         String
  // ACTIVE | ERROR | PAUSED
  status         String   @default("ACTIVE")
  lastSyncAt     DateTime?
  lastError      String?
  // Where reading continues from (IMAP UID and its validity).
  lastUid        Int      @default(0)
  uidValidity    String?
  createdById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([organisationId, address])
  @@index([status, lastSyncAt])
  @@map("support_mailboxes")
}

/// The organisation's support settings: opening hours, holidays and the AI threshold.
model SupportSetting {
  organisationId String   @id
  // { "1": ["08:00","17:00"], …, "6": ["09:00","13:00"] } (1 = Monday; missing = closed)
  hours          Json?
  // ["2026-10-01", …]
  holidays       String[] @default([])
  // How sure Enyo must be (0–1) before it answers by itself in AUTO queues.
  aiThreshold    Float    @default(0.75)
  nudgeAfterHours Int     @default(48)
  autoResolveDays Int     @default(7)
  closeAfterDays Int      @default(4)
  csatEnabled    Boolean  @default(true)
  // Public holidays come from a calendar worked out each year
  // ("NG": Nigeria's fixed dates, Easter dates and the Islamic holidays),
  // plus the extra days in `holidays`, minus any calendar days listed in
  // `holidaysOff` (e.g. the branch opens on Boxing Day). Null = no calendar.
  holidayCalendar String?  @default("NG")
  holidaysOff    String[] @default([])
  updatedById    String?
  updatedAt      DateTime @updatedAt

  @@map("support_settings")
}

model SupportReply {
  id           String        @id @default(cuid())
  ticketId     String
  ticket       SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  // Staff author; null when the customer wrote it.
  authorUserId String?
  fromCustomer Boolean       @default(false)
  body         String
  createdAt    DateTime      @default(now())
  // PUBLIC (the customer sees it) or INTERNAL (a colleague's note, never shown to the customer).
  visibility   String        @default("PUBLIC")
  // CUSTOMER | AGENT | AI | SYSTEM (acknowledgement, nudge) | NOTE
  kind         String        @default("AGENT")
  // Written with Enyo's help (a draft the colleague sent).
  aiDrafted    Boolean       @default(false)
  // Email threading: this message's Message-ID, and where it came from.
  emailMessageId String?
  fromAddress  String?
  // Attachment names and sizes (the files stay in the mailbox).
  attachments  Json?
  // Exactly-once intake of an email (mailbox + Message-ID hash).
  intakeKey    String?       @unique
  // Enyo's own replies and drafts: how sure it was, the model, the
  // approved answers it used, and what it knew about the sender (kind,
  // proven, the records and links it was given — never message text).
  aiConfidence Float?
  aiModel      String?
  aiSources    String[]      @default([])
  aiContext    Json?
  // A person's check of Enyo's reply (the Support centre's "Enyo's
  // replies" page): GOOD | FIXED (a corrected answer was written) | WRONG,
  // and for drafts automatically USED (sent nearly as written) | EDITED |
  // IGNORED. The reason is a fixed code (knowledge_gap, wrong_facts …).
  reviewStatus String?
  reviewReason String?
  reviewNote   String?
  reviewedById String?
  reviewedAt   DateTime?

  @@index([kind, reviewStatus, createdAt])
  @@index([ticketId, createdAt])
  @@index([emailMessageId])
  @@map("support_replies")
}

enum ReminderStatus {
  PENDING
  SENT
  DONE
  CANCELLED
}

/// A reminder for one person, set by them, by someone they allowed, or by Enyo at their request.
model Reminder {
  id             String         @id @default(cuid())
  organisationId String
  // Who is reminded.
  ownerId        String
  // Who set it (the owner, a delegate, or the owner through Enyo).
  createdById    String
  // form | enyo
  source         String         @default("form")
  title          String
  notes          String?
  dueAt          DateTime
  // Optional link to a record: JobCard, VehicleService, Customer, …
  recordType     String?
  recordId       String?
  recordRef      String?
  viaEmail       Boolean        @default(true)
  status         ReminderStatus @default(PENDING)
  sentAt         DateTime?
  doneAt         DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([status, dueAt])
  @@index([ownerId, status, dueAt])
  @@map("reminders")
}

/// "This person may set reminders for me."
model ReminderDelegate {
  id             String   @id @default(cuid())
  organisationId String
  ownerId        String
  delegateId     String
  createdAt      DateTime @default(now())

  @@unique([ownerId, delegateId])
  @@index([delegateId])
  @@map("reminder_delegates")
}

// What Enyo has learned: answers people marked helpful (first question of
// a chat, no records read), and replies colleagues wrote when Enyo handed a
// question over. Personal details removed. An administrator approves each one
// before Enyo uses it as an example or reuses it for the same question.
// Additive only.
model EnyoLearnedAnswer {
  id              String   @id @default(cuid())
  organisationId  String
  // STAFF | CUSTOMER | PUBLIC | SUPPORT
  channel         String
  question        String
  answer          String
  // The question's words as Enyo compares them (lib/enyo/predict/text.ts tokenise).
  tokens          Json
  // Where it came from: the rated answer, or the support reply.
  source          String
  sourceId        String   @unique
  // PENDING until an administrator approves it on the Enyo learning page;
  // only APPROVED answers are ever shown to the model or reused.
  status          String   @default("PENDING")
  approvedById    String?
  approvedAt      DateTime?
  uses            Int      @default(0)
  lastUsedAt      DateTime?
  createdById     String?
  createdAt       DateTime @default(now())

  @@index([organisationId, channel, status, createdAt])
  @@map("enyo_learned_answers")
}

// The integrity watch: unusual or risky activity found by the checks in
// apps/portal/lib/integrity (money, parts, gate, access, sign-ins). An administrator
// reviews each one; nobody reviews an alert about themselves. A flag is a
// reason to look, never proof: nothing is decided automatically.
// Additive only.
model IntegrityAlert {
  id             String    @id @default(cuid())
  organisationId String
  // The check that raised it (refund_exceeds_paid, same_person_approval …, speak_up).
  rule           String
  // LOW | MEDIUM | HIGH
  severity       String
  // NEW | REVIEWING | CONFIRMED | DISMISSED
  status         String    @default("NEW")
  title          String
  // Plain facts for the reviewer (amounts, dates, numbers — no message text).
  evidence       Json?
  // The record it is about, and the colleague whose activity it is about.
  entityType     String?
  entityId       String?
  subjectUserId  String?
  branchId       String?
  // One alert per rule and record: the checks run again and only update it.
  fingerprint    String
  score          Float?
  firstSeenAt    DateTime  @default(now())
  lastSeenAt     DateTime  @default(now())
  seenCount      Int       @default(1)
  // A Speak up report: who raised it (null when they chose to stay anonymous).
  reportedById   String?
  assignedToId   String?
  reviewedById   String?
  reviewedAt     DateTime?
  resolution     String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @default(now()) @updatedAt

  @@unique([organisationId, fingerprint])
  @@index([organisationId, status, severity, lastSeenAt])
  @@index([organisationId, rule, createdAt])
  @@index([subjectUserId])
  @@map("integrity_alerts")
}

// ─── Data Exchange: bringing existing data in from QuickBooks and spreadsheets ───
//
// One import = one file for one kind of record (customers, vehicles, …).
// The browser reads the file and sends its rows in blocks into ImportRow (a
// staging table), so a file of any size never travels in one request and an
// interrupted upload carries on. Nothing touches the live records until a
// second person approves; the load then runs in batches, can be paused, and
// is idempotent. Statuses are text (checked in code) so new steps never need
// a database type change.
model ImportJob {
  id             String   @id @default(cuid())
  // IMP-2026-000001
  number         String   @unique
  organisationId String
  // Branch-owned records (parts, stock) load into this branch; customers and vehicles do not need one.
  branchId       String?
  // customers | vehicles (later: parts, stock, suppliers, …)
  entity         String
  fileName       String
  // SHA-256 of the file as read in the browser: the same file twice is recognised.
  fileSha256     String
  fileRows       Int      @default(0)
  // The file's column headers, in order.
  headers        Json
  // { fieldKey: headerIndex } — which column feeds which field.
  mapping        Json?
  // ADD_ONLY: matches are skipped. FILL_BLANKS: matches get only their empty fields filled. Nothing is ever overwritten.
  matchMode      String   @default("ADD_ONLY")
  // Where the file came from: QUICKBOOKS | LEGACY (an old system or spreadsheet). Stamped on every record as externalSource.
  sourceSystem   String   @default("LEGACY")
  // Rows that only MIGHT be an existing record (same phone, different name and number): SKIP them (listed for
  // follow-up) or ADD them as new. Never merged silently.
  possibleDuplicates String @default("SKIP")
  // UPLOADING → UPLOADED → VALIDATING → VALIDATED → AWAITING_APPROVAL → APPROVED → LOADING ⇄ PAUSED → COMPLETED;
  // also CANCELLED, FAILED, UNDONE.
  status         String   @default("UPLOADING")
  goodRows       Int      @default(0)
  warningRows    Int      @default(0)
  rejectedRows   Int      @default(0)
  duplicateRows  Int      @default(0)
  matchedRows    Int      @default(0)
  createdRows    Int      @default(0)
  updatedRows    Int      @default(0)
  skippedRows    Int      @default(0)
  // Totals shown in the reconciliation report (e.g. stock quantity and value).
  totals         Json?
  // Opening stock: the cut-over date the stock was counted at — the date of its opening-balance receipts.
  asOf           DateTime?
  // Opening stock: Finance confirms the loaded quantity and value (a second sign-off after the Store's approval).
  signedOffById  String?
  signedOffAt    DateTime?
  // The staged copy of the file: bytes it takes (measured), and when it was
  // released (the summary, the report's outcomes, rejected rows and what undo
  // needs are kept; the rest of the file's cells are cleared).
  stagedBytes     Int?
  rowsReleasedAt  DateTime?
  rowsReleasedById String?
  error          String?
  createdById    String
  submittedAt    DateTime?
  approvedById   String?
  approvedAt     DateTime?
  startedAt      DateTime?
  completedAt    DateTime?
  undoneById     String?
  undoneAt       DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  createdBy    User         @relation("ImportJobCreatedBy", fields: [createdById], references: [id])
  approvedBy   User?        @relation("ImportJobApprovedBy", fields: [approvedById], references: [id])
  rows         ImportRow[]

  @@index([organisationId, createdAt])
  @@index([organisationId, entity, fileSha256])
  @@map("import_jobs")
}

/// One row of an imported file, as it was in the file, with what checking and loading made of it.
model ImportRow {
  id        String   @id @default(cuid())
  jobId     String
  // The row's line in the file (the header is line 1), as people see it in Excel.
  rowNumber Int
  // The cell values, in header order.
  cells     Json
  // PENDING → GOOD | WARNING | REJECTED | DUPLICATE; when loaded: CREATED | UPDATED | SKIPPED; UNDONE after an undo.
  status    String   @default("PENDING")
  // [{ field, message, level: "error" | "warning" }]
  issues    Json?
  // The keys the row is recognised by ("ext:1000123", "email:…", "vin:…"): finds duplicates across the whole file.
  keys      String[] @default([])
  // An existing record this row matched (by its old-system number, email, phone, VIN, plate…).
  matchedId String?
  matchedBy String?
  // The record created or updated from this row, and (FILL_BLANKS) which fields were filled — what an undo reverses.
  resultId  String?
  filled    String[] @default([])
  // An update from an edited export (matchMode UPDATE, P10): each change [{ field, label, from, to }] — previewed at the
  // check, what loaded after the load (a field changed in EJO meanwhile is left out), and what an undo puts back.
  changes   Json?

  job ImportJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, rowNumber])
  @@index([jobId, status])
  @@map("import_rows")
}

/// A saved column matching ("QuickBooks customer list", "Workshop Excel 2024"), offered for the next file of the same kind.
model ImportMappingProfile {
  id             String   @id @default(cuid())
  organisationId String
  entity         String
  name           String
  // { fieldKey: headerName } — by header name, so it fits a file whose columns are in another order.
  mapping        Json
  createdById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  createdBy    User         @relation("ImportMappingProfileCreatedBy", fields: [createdById], references: [id])

  @@unique([organisationId, entity, name])
  @@map("import_mapping_profiles")
}

/// The organisation's suppliers. Goods receipts keep the supplier's name as typed and link here when it
/// matches; brought in from QuickBooks or a spreadsheet, or typed in.
model Supplier {
  id             String   @id @default(cuid())
  organisationId String
  name           String
  contactName    String?
  phone          String?
  email          String?
  address        String?
  taxId          String?
  isActive       Boolean  @default(true)
  // The supplier's number in another system: externalSource where from, externalId the vendor number there.
  externalSource String?
  externalId     String?
  importJobId    String?
  createdById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organisation Organisation   @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  createdBy    User           @relation("SupplierCreatedBy", fields: [createdById], references: [id])
  receipts     GoodsReceipt[]

  @@unique([organisationId, externalSource, externalId])
  @@index([organisationId, name])
  @@index([importJobId])
  @@index([organisationId, externalId])
  @@map("suppliers")
}

// Data Exchange: invoices from QuickBooks or the old system (billing documents
// or customer line items) from before EJO. Read-only history: never edited, never paid or
// refunded here, never shown to the customer. Counted in the customer's total
// spend and last visit and in the CRM and analytics, always
// labelled "from before EJO". The customer (and the vehicle, matched by
// its VIN) are linked by id without a foreign key, so the history survives a
// customer moving through the Recycle bin. "Undo" voids rows (voidedAt) and
// a reload un-voids them: nothing is ever deleted.
model HistoricalInvoice {
  id             String    @id @default(cuid())
  organisationId String
  // The branch whose sales it was (chosen when the import starts).
  branchId       String?
  customerId     String
  vehicleId      String?
  // The chassis number as written on the invoice, and in capitals without spaces (to find the vehicle).
  vin            String?
  vinKey         String?
  // The invoice number in QuickBooks or the old system.
  invoiceNumber  String
  invoiceDate    DateTime  @db.Date
  // Gross amount in naira (net + tax when both are given); negative for a credit note.
  amount         Decimal   @db.Decimal(14, 2)
  // The old system's document type, e.g. Invoice, Credit Memo, Sales Receipt.
  documentType   String?
  description    String?
  externalSource String    @default("LEGACY")
  importJobId    String?
  voidedAt       DateTime?
  createdAt      DateTime  @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@unique([organisationId, externalSource, invoiceNumber], map: "historical_invoices_org_source_number_key")
  @@index([customerId, invoiceDate])
  @@index([organisationId, invoiceDate])
  // Search by the number alone (any company code and year).
  @@index([organisationId, invoiceNumber])
  @@index([vehicleId])
  @@index([vinKey])
  @@index([importJobId])
  @@map("historical_invoices")
}

/// A job card or routine service from before EJO (an old system's or
/// spreadsheet's job card), read-only history: shown on the
/// customer and the vehicle, counted as a visit, and the anchor of the
/// vehicle's next-service clock until EJO completes a service of its own.
/// Undo voids it (voidedAt); loading the file again restores it.
model HistoricalJob {
  id                 String    @id @default(cuid())
  organisationId     String
  branchId           String?
  customerId         String
  vehicleId          String?
  vin                String?
  vinKey             String?
  plateNumber        String?
  /// JOB_CARD (repair) or SERVICE (routine service).
  kind               String    @default("JOB_CARD")
  jobNumber          String
  invoiceNumber      String?
  openedAt           DateTime  @db.Date
  completedAt        DateTime? @db.Date
  mileage            Int?
  description        String?
  workDone           String?
  technician         String?
  labourAmount       Decimal?  @db.Decimal(14, 2)
  partsAmount        Decimal?  @db.Decimal(14, 2)
  totalAmount        Decimal?  @db.Decimal(14, 2)
  /// CLOSED (the default) or CANCELLED.
  status             String    @default("CLOSED")
  externalSource     String    @default("LEGACY")
  importJobId        String?
  /// The service tracker: staff marked the next-service prediction from this visit handled (or stopped tracking it).
  attendedAt         DateTime?
  voidedAt           DateTime?
  createdAt          DateTime  @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@unique([organisationId, externalSource, jobNumber], map: "historical_jobs_org_source_number_key")
  @@index([customerId, openedAt])
  @@index([organisationId, openedAt])
  @@index([organisationId, jobNumber])
  @@index([vehicleId, completedAt])
  @@index([vinKey])
  @@index([importJobId])
  @@map("historical_jobs")
}

/// The demo organisation's demo records that carry no externalSource of their
/// own (job cards, store receipts, gate exits, support, imports…): one row per record, so a reset removes exactly what
/// the last load made and never a record a person made. Written only by
/// apps/portal/lib/workshop/demo/load.ts.
model DemoRecord {
  id             String   @id @default(cuid())
  organisationId String
  /// The Prisma model name (JobCard, VehicleService, GoodsReceipt…).
  model          String
  recordId       String
  createdAt      DateTime @default(now())

  @@unique([model, recordId])
  @@index([organisationId, model])
  @@map("demo_records")
}

// A4 Data Exchange: one export of a list (Excel or CSV), as the person saw it
// — the list, its filters and search — recorded before any data leaves. The
// file is built as it downloads, from these filters and the person's own
// reach at that moment, so nothing is stored but this record. The link works
// for 24 hours, once per person (ExportDownload), for people who may open the
// list; every download is in the audit trail with its row count and size.
model ExportJob {
  id             String    @id @default(cuid())
  organisationId String
  // EXP-2026-000123
  number         String    @unique
  // Which list: customers, vehicles, parts, stock, job-cards…
  kind           String
  // xlsx | csv
  format         String
  // The list's filters, search and sort as the person had them.
  params         Json
  // What the filters said, in words (for the About sheet and the history).
  summary        String?
  // Customers' contact details or payments in it (needs the sensitive permission).
  sensitive      Boolean   @default(false)
  // Rows and bytes of the last download (the file is rebuilt each time).
  rowCount       Int?
  bytes          Int?
  createdById    String
  createdAt      DateTime  @default(now())
  expiresAt      DateTime

  organisation Organisation     @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  downloads    ExportDownload[]

  @@index([organisationId, createdAt])
  @@index([createdById, createdAt])
  @@map("export_jobs")
}

model ExportDownload {
  id          String    @id @default(cuid())
  exportJobId String
  userId      String
  /// When the latest part started (a large export comes in parts, each a complete file).
  startedAt   DateTime  @default(now())
  /// The whole export has been downloaded: the link no longer works for this person.
  finishedAt  DateTime?
  /// Parts written so far, and where the next part starts (null: from the beginning).
  parts       Int       @default(0)
  resumeFrom  String?
  /// When the latest part finished (a part is downloading while startedAt is later than this).
  partFinishedAt DateTime?
  rowCount    Int       @default(0)
  bytes       Int       @default(0)

  exportJob ExportJob @relation(fields: [exportJobId], references: [id], onDelete: Cascade)

  @@unique([exportJobId, userId])
  @@map("export_downloads")
}

// ----------------------------------------------------------------------------
// ASSEMBLY PLANT (Phase D)
// ----------------------------------------------------------------------------

// ─── A4c3 — scheduled exports ─────────────────────────────────────────────────
// A person's export repeated on a schedule: the list, the format and the
// filters (never the data). When it is due, EJO records a fresh export for
// its owner and tells them it is ready; the file is still built only when
// they download it, signed in, within their permissions at that moment.
// Nothing is emailed out, nothing is stored. A schedule whose owner has left
// or may no longer export the list pauses itself, saying why.
model ExportSchedule {
  id             String    @id @default(cuid())
  organisationId String
  ownerId        String
  // Which list (lib/exports/kinds), xlsx | csv, and the filters kept.
  kind           String
  format         String
  params         Json
  summary        String?
  sensitive      Boolean   @default(false)
  // DAILY | WEEKLY | MONTHLY
  cadence        String
  // WEEKLY: 1 (Monday) … 7 (Sunday). MONTHLY: 1 … 28.
  dayOfWeek      Int?
  dayOfMonth     Int?
  // ACTIVE | PAUSED | ENDED (ended schedules are kept, never deleted)
  status         String    @default("ACTIVE")
  // Why it paused itself (the owner left, or may no longer export the list).
  pausedReason   String?
  // The next day it is due, in Lagos (YYYY-MM-DD).
  nextRunOn      String
  lastRunAt      DateTime?
  lastExportId   String?
  runs           Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status, nextRunOn])
  @@index([organisationId, ownerId])
  @@map("export_schedules")
}

// ─────────────────────────────────────────────────────────────────────────
// CUSTOMER CARE: the callback list and "How did we do?" after every job.
// Complaints are support tickets of kind COMPLAINT (above).
// ─────────────────────────────────────────────────────────────────────────

enum ContactChannel {
  WHATSAPP
  PHONE
  EMAIL
}

enum FollowUpReason {
  // Two days after a vehicle is collected: is everything all right?
  AFTER_JOB
  // The customer asked to be called back.
  CALLBACK
  SERVICE_DUE
  BIRTHDAY
  COMPLAINT
  LOW_RATING
  OTHER
}

enum FollowUpStatus {
  OPEN
  DONE
  NO_ANSWER
  CANCELLED
}

/// One call or message front desk owes a customer: the callback list.
model FollowUp {
  id             String         @id @default(cuid())
  organisationId String
  branchId       String?
  customerId     String
  vehicleId      String?
  jobCardId      String?
  ticketId       String?
  reason         FollowUpReason
  note           String?
  dueAt          DateTime
  assignedToId   String?
  status         FollowUpStatus @default(OPEN)
  // What came of it ("Happy with the work", "Booked for Tuesday").
  outcome        String?
  attempts       Int            @default(0)
  doneAt         DateTime?
  doneById       String?
  // Made by the daily run (birthday, service due, after a job): one per
  // reason and occasion, so a second run never adds the same call twice.
  dedupeKey      String?        @unique
  createdById    String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  jobCard    JobCard? @relation(fields: [jobCardId], references: [id], onDelete: SetNull)
  assignedTo User?    @relation("FollowUpAssignee", fields: [assignedToId], references: [id])

  @@index([organisationId, status, dueAt])
  @@index([customerId, createdAt])
  @@index([assignedToId, status])
  @@map("follow_ups")
}

/// "How did we do?" after a job: one per Job Card, answered from a signed
/// link (the rating's id and an HMAC of it, so nothing secret is stored and
/// the same link can be sent again by WhatsApp or email). A score of 3 or
/// less opens a complaint and a callback.
model JobRating {
  id             String    @id @default(cuid())
  organisationId String
  jobCardId      String    @unique
  customerId     String
  sentAt         DateTime  @default(now())
  expiresAt      DateTime
  // 1 (poor) to 5 (excellent).
  score          Int?
  comment        String?
  wouldRecommend Boolean?
  respondedAt    DateTime?
  // The complaint a low score opened.
  ticketId       String?
  createdAt      DateTime  @default(now())

  jobCard  JobCard  @relation(fields: [jobCardId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([organisationId, respondedAt])
  @@map("job_ratings")
}

/// A photo on a Job Card: the vehicle's condition at check-in, the work, the
/// quality check or the collection. Resized in the browser before upload
/// (about 1280 px, JPEG), kept in the database so a backup holds everything,
/// and served only to staff who may open the Job Card.
model JobCardPhoto {
  id          String   @id @default(cuid())
  jobCardId   String
  // CHECK_IN | WORK | QUALITY | COLLECTION
  stage       String   @default("CHECK_IN")
  contentType String
  bytes       Bytes
  sizeBytes   Int
  width       Int?
  height      Int?
  caption     String?
  takenById   String?
  createdAt   DateTime @default(now())

  jobCard JobCard @relation(fields: [jobCardId], references: [id], onDelete: Cascade)

  @@index([jobCardId, createdAt])
  @@map("job_card_photos")
}
