# ---------------------------------------------------------------------------
# Rock Foundation Automobile (EJO): environment variables, example values only.
# Copy to .env for local work and fill in your own values. Never commit .env.
# On Vercel, set them per project (staff portal and customer portal) and per
# environment. docs/OPERATIONS_CHECKLIST.md says which project needs which.
# Secrets go only into the hosting settings, never into code, chat or email.
# ---------------------------------------------------------------------------

# ── Database (Supabase Postgres) ───────────────────────────────────────────
# DATABASE_URL: the pooled connection (transaction pooler, port 6543) used at
# run time; keep pgbouncer=true on it. DIRECT_URL: the direct connection
# (port 5432) that schema pushes need. Plain Postgres strings: another
# provider only means changing these two values.
DATABASE_URL="postgresql://postgres.your-project:password@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:password@db.your-project.supabase.co:5432/postgres"
# Optional: connections per server instance and how long to wait for one.
# PRISMA_CONNECTION_LIMIT="5"
# PRISMA_POOL_TIMEOUT="20"
# The database plan's size in MB. Imports that would not fit are refused and a
# load near the limit pauses. 0 switches the checks off. Supabase Pro: 8000.
# DATABASE_SPACE_LIMIT_MB="8000"

# ── First sign-in ──────────────────────────────────────────────────────────
# The platform administrator made by packages/database/prisma/seed.ts. The
# password is used only when the account is first created; re-running the
# seed never changes it unless RESET_MASTER_ADMIN_PASSWORD=yes (one run).
# Remove the password from the hosting settings once the account exists.
MASTER_ADMIN_NAME="Platform Administrator"
MASTER_ADMIN_EMAIL="admin@example.com"
MASTER_ADMIN_PASSWORD="change-me-to-a-long-unique-password"
# RESET_MASTER_ADMIN_PASSWORD="yes"
# The platform owner account (only the owner can change it).
PLATFORM_OWNER_EMAIL="owner@example.com"

# ── Demo organisation (docs/DEMO.md) ───────────────────────────────────────
# "Rock Foundation Automobile (Demo)", its own organisation, never the real
# one. One password for every demo person, 8 characters or more; leave it
# unset for no demo. A password already set is changed only with
# RESET_DEMO_PASSWORDS=yes (one run).
# DEMO_STAFF_PASSWORD="choose-a-demo-password"
# DEMO_CUSTOMER_PASSWORD="optional-customer-portal-demo-password"
# DEMO_ORG_SLUG="rock-foundation-demo"
# RESET_DEMO_PASSWORDS="yes"
# Needed to reset the demo against a production database (the exact words):
# DEMO_RESET_CONFIRM="replace the demo records"
# DEMO_STRICT="1"   # a demo problem stops the build instead of only warning

# ── Sign-in (Better Auth) ──────────────────────────────────────────────────
# Shared by the staff portal and the customer portal. Generate with:
#   openssl rand -base64 48
BETTER_AUTH_SECRET="replace-with-a-long-random-secret"
# The staff portal's own address.
BETTER_AUTH_URL="http://localhost:3001"
# Extra addresses allowed to call the sign-in endpoints, comma-separated
# (for example the vercel.app address while a custom domain is the main one).
# BETTER_AUTH_TRUSTED_ORIGINS="https://portal.example.com"
# Only when a proxy in front of the app changes the host name (comma-separated hosts).
# SERVER_ACTIONS_ALLOWED_ORIGINS="portal.example.com"

# Sign-in limits per internet address (optional; defaults shown).
# AUTH_SIGNIN_PER_MINUTE="20"
# AUTH_RESET_REQUESTS_PER_5_MIN="5"
# CUSTOMER_SIGNIN_PER_MINUTE="20"
# CUSTOMER_RESET_REQUESTS_PER_5_MIN="5"

# ── Public addresses ───────────────────────────────────────────────────────
# Required in production: a production build on Vercel stops without them.
NEXT_PUBLIC_PORTAL_URL="http://localhost:3001"
NEXT_PUBLIC_WEBSITE_URL="http://localhost:3000"

# ── The business, shown before anyone signs in ─────────────────────────────
# Sign-in pages and the customer portal. Inside the staff portal the
# organisation record (Business details) is used. NEXT_PUBLIC_* values are
# read when the app is built: redeploy after changing them.
NEXT_PUBLIC_ORGANISATION_NAME="Rock Foundation Automobile"
NEXT_PUBLIC_ORGANISATION_LEGAL_NAME="Rock Foundation Automobile Investment Ltd"
NEXT_PUBLIC_SITE_TAGLINE="Trust your vehicle to the certified service experts."
# NEXT_PUBLIC_SITE_DESCRIPTION="Auto diagnostics, repairs, servicing, spraying and car wash for all car makes in Ota, Ogun State."
NEXT_PUBLIC_CONTACT_ADDRESS="1, Heal The World Avenue, Opp. Gateway Hotel, Ota, Ogun State"
NEXT_PUBLIC_CONTACT_PHONE="+234 803 304 9194"
# NEXT_PUBLIC_CONTACT_EMAIL=""          # leave empty until the workshop publishes one
# NEXT_PUBLIC_APP_SHORT_NAME="Rock Foundation"   # the phone home-screen name
# NEXT_PUBLIC_SOCIAL_FACEBOOK=""
# NEXT_PUBLIC_SOCIAL_INSTAGRAM=""
# NEXT_PUBLIC_SOCIAL_LINKEDIN=""
# NEXT_PUBLIC_SOCIAL_X=""
# NEXT_PUBLIC_SOCIAL_YOUTUBE=""
# The organisation the customer portal belongs to (its slug).
# WEBSITE_ORGANISATION_SLUG="rock-foundation"

# ── Email (Nodemailer, SMTP) ───────────────────────────────────────────────
# SMTP_FROM's display name is what customers see.
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Rock Foundation Automobile <no-reply@example.com>"
# A copy of every outgoing email to these addresses (comma-separated), or "off".
# MAIL_OBSERVER_BCC=""

# The Support centre's shared mailboxes: 32 random bytes, base64. Encrypts
# each mailbox password at rest. Generate: openssl rand -base64 32
# Changing it disconnects every mailbox (an administrator reconnects once).
# MAILBOX_ENCRYPTION_KEY=""

# ── Scheduled jobs ─────────────────────────────────────────────────────────
# Vercel Cron and the Supabase scheduler send it as a bearer token.
CRON_SECRET="replace-with-a-long-random-secret"
# Days a record deleted by mistake stays restorable in the Recycle bin
# (optional; default 30, kept between 7 and 90).
# RECYCLE_BIN_DAYS="30"

# ── Instant updates (optional) ─────────────────────────────────────────────
# Supabase Realtime "something changed" pings. Both values are public by
# design (Supabase → Project Settings → API); no business data travels on
# the channel. Without them the portal checks every few seconds instead.
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="replace-me-with-the-anon-public-key"

# ── Enyo, the assistant (staff portal AND customer portal) ─────────────────
# Leave the key unset and Enyo shows "not switched on yet"; everything else
# works as before. Server-side only: never prefix these with NEXT_PUBLIC_.
# Anthropic Claude: the key comes from console.anthropic.com → API Keys
# (billing set up, a monthly spend limit recommended).
# ENYO_LLM_PROVIDER="anthropic"
# ENYO_LLM_API_KEY=""
# ENYO_LLM_MODEL="claude-opus-5-5"        # the default
# ENYO_LLM_FAST_MODEL="claude-haiku-5-5"  # the default: greetings, how-to, short answers
# ENYO_LLM_PROVIDER_LABEL="Anthropic Claude"
# ENYO_LLM_EFFORT="medium"                # optional: low | medium | high | xhigh | max
# ENYO_LLM_FAST_EFFORT="low"
# ENYO_LLM_ROUTING="on"                   # "off": always the main model
# ENYO_LLM_FALLBACK_MODELS=""             # optional, comma-separated, tried in order
# ENYO_LLM_TIMEOUT_MS="45000"
# ENYO_REQUESTS_PER_MINUTE="20"           # per staff member
# ENYO_WEB_LOOKUP="on"                    # "off" stops general-knowledge look-ups
# ENYO_FREE_WEB_SEARCH="on"               # "off" stops the free web search
# A web search engine as well (set ONE, in the hosting settings only):
# SERPER_API_KEY=""
# BRAVE_SEARCH_API_KEY=""
# TAVILY_API_KEY=""

# Enyo on the customer portal: limits per customer, per visitor and per address.
# ENYO_IP_HASH_KEY=""             # random secret, only for hashing addresses (rate limits)
# ENYO_CUSTOMER_PER_MINUTE="12"
# ENYO_PUBLIC_PER_MINUTE="6"
# ENYO_PUBLIC_PER_DAY="60"
# ENYO_PUBLIC_IP_PER_MINUTE="20"
# ENYO_PUBLIC_IP_PER_DAY="200"

# ── Planned, not read by the code yet ──────────────────────────────────────
# Listed so the hosting settings can be prepared. Each switch stays off until
# its phase is released and the Owner turns it on in Settings.
#
# Automatic WhatsApp (Meta WhatsApp Business Platform), Phase 6:
# WHATSAPP_PHONE_NUMBER_ID=""
# WHATSAPP_ACCESS_TOKEN=""       # a permanent system-user token
# WHATSAPP_APP_SECRET=""         # checks that delivery receipts come from Meta
# WHATSAPP_GRAPH_VERSION="v26.0"
#
# QuickBooks Online connection (off by default), Phase 7:
# QUICKBOOKS_CLIENT_ID=""
# QUICKBOOKS_CLIENT_SECRET=""
# QUICKBOOKS_REDIRECT_URI="https://portal.example.com/api/quickbooks/callback"
# QUICKBOOKS_ENVIRONMENT="sandbox"   # sandbox | production
#
# Nightly backup copy to Cloudflare R2 (optional), Phase 9:
# R2_ACCOUNT_ID=""
# R2_ACCESS_KEY_ID=""
# R2_SECRET_ACCESS_KEY=""
# R2_BUCKET="rock-foundation-backups"

# ── Tests only (never in production) ───────────────────────────────────────
# A throwaway database for the concurrency tests (apps/portal/tests/concurrency.db.test.ts).
# TEST_DATABASE_URL="postgresql://postgres:password@localhost:5432/postgres"
# Plain connections to the local test mail server (ignored on a production build outside CI).
# MAILBOX_ALLOW_INSECURE="1"
